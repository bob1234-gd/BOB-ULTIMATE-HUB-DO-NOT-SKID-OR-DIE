local SearchBar = Instance.new("TextBox", MainFrame)
SearchBar.Size = UDim2.new(1, -40, 0, 40)
SearchBar.Position = UDim2.new(0, 20, 0, 50)
SearchBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
SearchBar.PlaceholderText = "Loading words..."
SearchBar.TextColor3 = Color3.new(1, 1, 1)
SearchBar.TextSize = 16
Instance.new("UICorner", SearchBar)

local Scroll = Instance.new("ScrollingFrame", MainFrame)
Scroll.Size = UDim2.new(1, -20, 1, -110)
Scroll.Position = UDim2.new(0, 10, 0, 100)
Scroll.BackgroundTransparency = 1
Scroll.ScrollBarThickness = 4

local Layout = Instance.new("UIListLayout", Scroll)
Layout.Padding = UDim.new(0, 5)

local words = {}

task.spawn(function()
    local urls = {
        "https://raw.githubusercontent.com/bob1234-gd/BOB-ULTIMATE-HUB-DO-NOT-SKID-OR-DIE/main/words.txt",
        "https://raw.githubusercontent.com/bob1234-gd/BOB-ULTIMATE-HUB-DO-NOT-SKID-OR-DIE/main/words",
        "https://gist.githubusercontent.com/eyturner/3d56f6a194f411af9f29df4c9d4a4e6e/raw/20k.txt"
    }
   
    for _, url in ipairs(urls) do
        local success, response = pcall(function()
            return game:HttpGet(url, true)
        end)
       
        if success and response and #response > 1000 then
            for word in response:gmatch("[^\r\n]+") do
                local trimmed = word:match("^%s*(.-)%s*$")
                if #trimmed > 1 then
                    table.insert(words, trimmed)
                end
            end
            SearchBar.PlaceholderText = "Search (" .. #words .. " words loaded)"
            print("Loaded from: " .. url)
            return
        end
    end
   
    SearchBar.PlaceholderText = "Failed to load words"
end)

local function update()
    for _, v in ipairs(Scroll:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end

    local input = SearchBar.Text:lower()
    if input == "" then return end

    local count = 0
    for _, word in ipairs(words) do
        if word:lower():find(input, 1, true) then
            count = count + 1
            local b = Instance.new("TextButton", Scroll)
            b.Size = UDim2.new(0.95, 0, 0, 35)
            b.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            b.Text = word
            b.TextColor3 = Color3.new(1,1,1)
            b.TextSize = 18
            Instance.new("UICorner", b)

            b.MouseButton1Click:Connect(function()
                setclipboard(word)
                b.Text = "✅ COPIED!"
                task.wait(1)
                b.Text = word
            end)

            if count >= 50 then break end
        end
    end
    Scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y)
end

SearchBar:GetPropertyChangedSignal("Text"):Connect(update)
