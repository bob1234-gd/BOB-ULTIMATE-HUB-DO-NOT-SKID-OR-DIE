-- THEME REFRESHER ENGINE
-- =============================================================================
local function updateTheme(newColor)
    currentThemeColor = newColor
    for _, element in ipairs(registeredElements) do
        if element and element.Parent then
            if element:IsA("UIStroke") then
                element.Color = newColor
            elseif element:IsA("TextButton") and (element.Name == "SendButton" or element:GetAttribute("BobThemeFill")) then
                element.BackgroundColor3 = newColor
            elseif element.Name == "TopBarAccent" or element.Name == "AccentLine" or element.Name == "AvatarRing" or element.Name == "ThemeAccent" then
                element.BackgroundColor3 = newColor
            elseif element:IsA("TextLabel") and element.Name == "TabButtonText" and element.Parent and element.Parent.Name == "ActiveTab" then
                element.TextColor3 = newColor
            end
        end
    end
end

local function stopRainbow()
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end
end

local function startRainbow()
    stopRainbow()
    rainbowConnection = RunService.RenderStepped:Connect(function()
        local hue = (tick() % 4) / 4
        local color = Color3.fromHSV(hue, 1, 1)
        updateTheme(color)
    end)
end

ScreenGui.Destroying:Connect(stopRainbow)

