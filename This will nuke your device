            SubContainer.Visible = true
            SubBtn.BackgroundColor3 = currentThemeColor
            SubBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        return api
    end

    return { Parent = parent, Container = parent.Container, AddSubTab = addSubTab, SubTabs = subTabs }
