local function bobGetEnv()
    if getgenv then return getgenv() end
    return _G
end

local function bobGetConfig()
    local env = bobGetEnv()
    env.BobUltimateConfig = env.BobUltimateConfig or {}
    return env.BobUltimateConfig
end

local function bobSaveConfig()
    local cfg = bobGetConfig()
    local env = bobGetEnv()
    env.BobUltimateConfig = cfg
    -- persist to file when possible
    local encodeOk, payload = pcall(function()
        return game:GetService("HttpService"):JSONEncode(cfg)
    end)
    if encodeOk and (writefile or (syn and syn.write_file)) then
        local w = writefile or syn.write_file
        pcall(function() w("BobUltimate_config.json", payload) end)
    end
end

local function bobLoadConfigFromFile()
    local cfg = bobGetConfig()
    if not (isfile and readfile) then return cfg end
    local ok, data = pcall(function()
        if isfile("BobUltimate_config.json") then
            return readfile("BobUltimate_config.json")
        end
        return nil
    end)
    if ok and data and data ~= "" then
        local decOk, decoded = pcall(function()
            return game:GetService("HttpService"):JSONDecode(data)
        end)
        if decOk and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                if cfg[k] == nil then cfg[k] = v end
            end
        end
    end
    return cfg
end

bobLoadConfigFromFile()

local function bobSendChat(message)
    if not message or message == "" then return end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if ch then pcall(function() ch:SendAsync(message) end) return end
    end
    local dcs = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if dcs then
        local smr = dcs:FindFirstChild("SayMessageRequest")
        if smr then pcall(function() smr:FireServer(message, "All") end) end
    end
end

local function bobGetTimeStat()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return nil end
    local t = ls:FindFirstChild("Time") or ls:FindFirstChild("time")
    if not t then return nil end
    return tonumber(t.Value)
end

local function bobDonate(targetName, amount, useInvisible)
    if not targetName or targetName == "" then return end
    -- Prefer display name with _ → . (TCO targeting style: G_Green → G.Green)
    local donateTarget = targetName
    local plr = Players:FindFirstChild(targetName)
    if plr then
        donateTarget = (plr.DisplayName or plr.Name):gsub("_", ".")
    else
        donateTarget = tostring(targetName):gsub("_", ".")
    end
    local prefix = useInvisible and ";" or ""
    local amt = tonumber(amount)
    local msg
    if amt and amt > 0 then
        msg = string.format("%sdonate %s %s", prefix, donateTarget, tostring(amt))
    else
        msg = string.format("%sdonate %s", prefix, donateTarget)
    end
    bobSendChat(msg)
end

local function bobRejoinWithConfig()
    bobSaveConfig()
    local cfg = bobGetConfig()
    local env = bobGetEnv()
    -- queue re-exec bootstrap: restore config, set flag to re-run hub from autoexec/file if present
    local queueFn = (queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport))
    if queueFn then
        local payload = string.format([[
            local HttpService = game:GetService("HttpService")
            local ok, cfg = pcall(function()
                return HttpService:JSONDecode(%q)
            end)
            local env = (getgenv and getgenv()) or _G
            if ok and type(cfg) == "table" then
                env.BobUltimateConfig = cfg
            end
            env.BobUltimate_PendingRestore = true
            -- try re-run saved hub script
            if readfile and isfile then
                pcall(function()
                    if isfile("BobUltimate_hub.lua") then
                        loadstring(readfile("BobUltimate_hub.lua"))()
                    end
                end)
            end
        ]], (pcall(function() return game:GetService("HttpService"):JSONEncode(cfg) end) and game:GetService("HttpService"):JSONEncode(cfg) or "{}"))
        pcall(queueFn, payload)
    end
    -- also try save current script source if available (some executors expose it)
    if writefile and typeof and typeof(script) ~= "Instance" then
        -- no reliable source; skip
    end
    ShowNotification("Anti's", "Rejoining to clear mute/dumb/genius...")
    task.wait(0.4)
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
end

