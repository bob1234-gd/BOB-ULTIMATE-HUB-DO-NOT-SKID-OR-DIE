                return
            end
            ShowNotification("Map Store", "Downloading " .. map.Name .. "...")
            local body = httpGetBody(map.Url)
            if not body then
                ShowNotification("Map Store", "Download failed.")
                return
            end
            body = extractBuildString(body)
            if _G.ABTextBox then
                _G.ABTextBox.Text = body
                ShowNotification("Map Store", map.Name .. " loaded into Auto Builder!")
            else
                ShowNotification("Error", "Auto Builder not ready.")
            end
        end)
    end)
    if btn and btn.Parent then
        table.insert(remoteMapButtons, btn)
    end
end

local function parseMapIndex(body)
    local list = {}
    if not body or body == "" then return list end

    -- Try JSON array: [{"Name":"...","Author":"...","Url":"..."}, ...]
    local ok, decoded = pcall(function()
        return game:GetService("HttpService"):JSONDecode(body)
    end)
    if ok and type(decoded) == "table" then
        if decoded[1] then
            for _, m in ipairs(decoded) do
                if type(m) == "table" and (m.Name or m.name) and (m.Url or m.url) then
                    table.insert(list, {
                        Name = m.Name or m.name,
                        Author = m.Author or m.author or "Unknown",
                        Url = m.Url or m.url
                    })
                end
            end
            return list
        end
    end

    -- Try Lua loadstring returning a table
    ok, decoded = pcall(function()
        local fn = loadstring(body)
        if not fn then return nil end
        local result = fn()
        return result
    end)
    if ok and type(decoded) == "table" then
        for _, m in ipairs(decoded) do
            if type(m) == "table" and (m.Name or m.name) and (m.Url or m.url) then
                table.insert(list, {
                    Name = m.Name or m.name,
                    Author = m.Author or m.author or "Unknown",
                    Url = m.Url or m.url
                })
            end
        end
        if #list > 0 then return list end
    end

    return list
end

local function refreshRemoteCatalog()
    clearRemoteMapButtons()
    remoteMaps = {}
    ShowNotification("Map Store", "Fetching map catalog...")

    task.spawn(function()
        for _, url in ipairs(MAP_INDEX_URLS) do
            local body = httpGetBody(url)
            if body then
                local list = parseMapIndex(body)
                if #list > 0 then
                    remoteMaps = list
                    break
                end
            end
        end

        if #remoteMaps == 0 then
            ShowNotification("Map Store", "No remote catalog found. Use Load URL / paste.ee below.")
            return
        end

        for _, map in ipairs(remoteMaps) do
            addRemoteMapButton(map)
        end
        ShowNotification("Map Store", "Loaded " .. #remoteMaps .. " maps from catalog.")
    end)
end

