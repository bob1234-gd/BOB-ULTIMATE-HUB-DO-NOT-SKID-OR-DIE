        local function legalMoves(sx, sy)
            local p = board[sy][sx]
            if p == "" then return {} end
            local side, kind = p:sub(1,1), p:sub(2,2)
            local moves = {}
            local function add(x, y)
                if not inBounds(x, y) then return false end
                local t = board[y][x]
                if t == "" then
                    table.insert(moves, {x = x, y = y})
                    return true
                end
                if t:sub(1,1) ~= side then
                    table.insert(moves, {x = x, y = y})
                end
                return false
            end
            local function ray(dx, dy)
                local x, y = sx + dx, sy + dy
                while inBounds(x, y) do
                    if not add(x, y) then break end
                    if board[y][x] ~= "" then break end
                    x, y = x + dx, y + dy
                end
            end
            if kind == "P" then
                local dir = (side == "w") and -1 or 1
                local startRow = (side == "w") and 7 or 2
                if inBounds(sx, sy + dir) and board[sy + dir][sx] == "" then
                    table.insert(moves, {x = sx, y = sy + dir})
                    if sy == startRow and board[sy + dir * 2][sx] == "" then
                        table.insert(moves, {x = sx, y = sy + dir * 2})
                    end
                end
                for _, dx in ipairs({-1, 1}) do
                    local x, y = sx + dx, sy + dir
                    if inBounds(x, y) and board[y][x] ~= "" and board[y][x]:sub(1,1) ~= side then
                        table.insert(moves, {x = x, y = y})
                    end
                end
            elseif kind == "N" then
                for _, d in ipairs({{1,2},{2,1},{-1,2},{-2,1},{1,-2},{2,-1},{-1,-2},{-2,-1}}) do
                    add(sx + d[1], sy + d[2])
                end
            elseif kind == "B" then
                ray(1,1) ray(1,-1) ray(-1,1) ray(-1,-1)
            elseif kind == "R" then
                ray(1,0) ray(-1,0) ray(0,1) ray(0,-1)
            elseif kind == "Q" then
                ray(1,0) ray(-1,0) ray(0,1) ray(0,-1) ray(1,1) ray(1,-1) ray(-1,1) ray(-1,-1)
            elseif kind == "K" then
                for dy = -1, 1 do
                    for dx = -1, 1 do
                        if not (dx == 0 and dy == 0) then add(sx + dx, sy + dy) end
                    end
                end
            end
            return moves
        end

