local function isCorruptedTimeText(text)
    if text == nil then return false end
    text = tostring(text)
    -- mute emoji or any non-numeric (allow digits, spaces, commas, dots, colons for time formats)
    if text:find("🤐") then return true end
    -- strip common time formatting then check
    local cleaned = text:gsub("[%d%s%.,:%-%+/]", "")
    if cleaned ~= "" then
        return true -- leftover letters/symbols/emojis
    end
    return false
end

local function checkTiempoBillboard(char)
    if not char then return false end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BillboardGui") and desc.Name:lower() == "tiempo" then
            for _, child in ipairs(desc:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                    local n = child.Name:lower()
                    if n == "text1" or n == "text2" or n:find("text") then
                        if isCorruptedTimeText(child.Text) then
                            return true
                        end
                    end
                end
            end
            -- also check any text under tiempo
            for _, child in ipairs(desc:GetDescendants()) do
                if (child:IsA("TextLabel") or child:IsA("TextButton")) and isCorruptedTimeText(child.Text) then
                    return true
                end
            end
        end
    end
    return false
end

