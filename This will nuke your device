-- Core purchase — InvokeServer returns nil so we only check pcall success
local function attemptPurchase(item, qty)
    local remote = getItemBoughtRemote()
    if not remote then return false end
    local itemGainedGui = LocalPlayer.PlayerGui:FindFirstChild("ItemGained")
    if itemGainedGui then
        local nameVal = itemGainedGui:FindFirstChild("LastItemBoughtName")
        if nameVal then pcall(function() nameVal.Value = item.itemName end) end
    end
    local success, err = pcall(function()
        remote:InvokeServer(item.itemName, qty)
    end)
    if not success then warn("Buy Error: " .. tostring(err)) end
    return success
end

