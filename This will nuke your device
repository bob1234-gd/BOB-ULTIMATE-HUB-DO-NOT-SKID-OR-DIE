-- ========== PAINT SWEEP ==========
PaintTab.AddSectionHeader("Paint")
local PaintAllBtn = PaintTab.AddButton("Paint Target Bricks [OFF]", function() end)

local function runPaintSweep()
    if isPainting then
        isPainting = false
        PaintAllBtn.Text = "Paint Target Bricks [OFF]"
        PaintAllBtn.TextColor3 = Color3.fromRGB(220, 221, 222)
        ShowNotification("Paint", "Paint stopped.")
        return
    end
    local tool = getPaintTool()
    if not tool then ShowNotification("Error", "You must own the 'Paint' tool!") return end
    local remote = getPaintRemote(tool)
    if not remote then ShowNotification("Error", "Paint remote not found.") return end
    if not ensurePaintEquipped(tool) then ShowNotification("Error", "Could not equip Paint.") return end
    local parts, err = collectTargets()
    if err then ShowNotification("Error", err) return end
    if #parts == 0 then ShowNotification("Paint", "No bricks found.") return end

    isPainting = true
    PaintAllBtn.Text = "Stop Paint [ON]"
    PaintAllBtn.TextColor3 = Color3.fromRGB(67, 181, 129)
    ShowNotification("Paint", string.format("Painting %d bricks (%s) — multi-pass...", #parts, paintMaterial))

    task.spawn(function()
        -- Adaptive: MORE blocks = FASTER, FEWER = slower/careful
        local function getPaintTiming(count)
            if count >= 400 then
                return 0.025, 0.015, 1, 0.12   -- tp, paintWait, paintsPerPart, passPause
            elseif count >= 150 then
                return 0.04, 0.03, 1, 0.18
            elseif count >= 50 then
                return 0.06, 0.045, 2, 0.25
            else
                return 0.09, 0.06, 2, 0.35
            end
        end
        local maxPasses = 3

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local originalPos = root and root.CFrame

        for pass = 1, maxPasses do
            if not isPainting then break end
            local list = parts
            if pass > 1 then
                local again = select(1, collectTargets())
                if again and #again > 0 then list = again end
            end

            local TP_WAIT, PAINT_WAIT, paintsPerPart, PASS_PAUSE = getPaintTiming(#list)

            tool = getPaintTool()
            remote = getPaintRemote(tool)
            ensurePaintEquipped(tool)
            char = LocalPlayer.Character
            root = char and char:FindFirstChild("HumanoidRootPart")

            for i, part in ipairs(list) do
                if not isPainting then break end
                if part and part.Parent then
                    if root then
                        pcall(function()
                            char:PivotTo(part.CFrame + Vector3.new(0, 5, 0))
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                        end)
                        task.wait(TP_WAIT)
                    end
                    for _ = 1, paintsPerPart do
                        if not isPainting or not part.Parent then break end
                        paintOne(remote, part)
                        task.wait(PAINT_WAIT)
                    end
                end
            end
            task.wait(PASS_PAUSE)
        end

        if root and originalPos then pcall(function() char:PivotTo(originalPos) end) end
        isPainting = false
        PaintAllBtn.Text = "Paint Target Bricks [OFF]"
        PaintAllBtn.TextColor3 = Color3.fromRGB(220, 221, 222)
        ShowNotification("Paint", "Paint sweep finished (multi-pass).")
    end)
end

