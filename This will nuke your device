local MAP_INDEX_URLS = {
    "https://raw.githubusercontent.com/bob1234-gd/BOB-ULTIMATE-HUB-DO-NOT-SKID-OR-DIE/refs/heads/main/MapIndex.lua",
    "https://raw.githubusercontent.com/bob1234-gd/BOB-ULTIMATE-HUB-DO-NOT-SKID-OR-DIE/refs/heads/main/map_index.json",
