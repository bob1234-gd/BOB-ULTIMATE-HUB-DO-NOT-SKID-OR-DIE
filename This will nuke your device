-- Parse rank commands from chat: roblox.com/[Username]/Rank/[N]
local function tryParseRankCommand(text)
    if not text then return end
    local user, num = text:match("roblox%.com/([%w_]+)/Rank/(%d+)")
    if user and num then
        setPlayerRank(user, tonumber(num))
        return true
    end
    return false
end

