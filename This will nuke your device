local function normalizeName(n)
    return string.lower(tostring(n or ""):gsub("%s+", ""))
end

local function getVipByPlayer(plr)
    if not plr then return nil end
    return BOB_VIPS[normalizeName(plr.Name)] or BOB_VIPS[normalizeName(plr.DisplayName)]
end

local function getVipByUserId(userId)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.UserId == userId then return getVipByPlayer(p) end
    end
    return nil
end

local function getVipByName(name)
    return BOB_VIPS[normalizeName(name)]
end

local function isLocalVip()
    return getVipByPlayer(LocalPlayer) ~= nil
end

local function ownsExecutorPass()
    if isLocalVip() then return true end
    local ok, res = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, EXECUTOR_GAMEPASS_ID)
    end)
    return ok and res == true
end

local function isSignedIn()
    if isLocalVip() then return true end
    return _G.BobAuth and _G.BobAuth.signedIn == true and not _G.BobAuth.isGuest
end

local function isGuest()
    if isLocalVip() then return false end
    return not isSignedIn()
end

-- Feature access helpers
local function canUsePremiumFeatures()
    return isSignedIn() or isLocalVip()
end

local function canUseExecutor()
    return (isSignedIn() or isLocalVip()) and ownsExecutorPass()
end


