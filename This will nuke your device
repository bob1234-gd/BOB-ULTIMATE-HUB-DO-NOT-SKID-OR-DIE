local cmdTarget = "me"

local function sendChatRaw(message)
    if not message or message == "" then return end
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local textChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if textChannel then
            pcall(function() textChannel:SendAsync(message) end)
            return
        end
    end
    local defaultChatSystem = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if defaultChatSystem then
        local sayMessageRequest = defaultChatSystem:FindFirstChild("SayMessageRequest")
        if sayMessageRequest then
            pcall(function() sayMessageRequest:FireServer(message, "All") end)
        end
    end
end

local function runCmd(cmdName, extraArg)
    -- Build: [;]cmd target [extra]
    local prefix = invisibleCmd and ";" or ""
    local parts = {prefix .. cmdName}
    if cmdTarget and cmdTarget ~= "" then
        table.insert(parts, cmdTarget)
    end
    if extraArg and extraArg ~= "" then
        table.insert(parts, extraArg)
    end
    local msg = table.concat(parts, " ")
    sendChatRaw(msg)
    ShowNotification("Quick Cmds", "Sent: " .. msg)
end

-- Commands that take NO target (world / self-only style with "-")
local NO_TARGET_CMDS = {
    autumn = true, classic = true, clearsky = true, cloudy = true,
    darkspring = true, day = true, epic = true, getseed = true,
    joinog = true, joinvc = true, joinxl = true, modern = true,
    namek = true, night = true, players = true, premium = true,
    realistic = true, smooth = true, spring = true, storm = true,
    summer = true, winter = true, filesize = true, cmds = true,
}

local function runCmdSmart(cmdName, extraArg)
    local prefix = invisibleCmd and ";" or ""
    local lower = string.lower(cmdName)
    local msg
    if NO_TARGET_CMDS[lower] then
        msg = prefix .. cmdName
        if extraArg and extraArg ~= "" then
            msg = msg .. " " .. extraArg
        end
    else
        msg = prefix .. cmdName
        if cmdTarget and cmdTarget ~= "" then
            msg = msg .. " " .. cmdTarget
        end
        if extraArg and extraArg ~= "" then
            msg = msg .. " " .. extraArg
        end
    end
    sendChatRaw(msg)
    ShowNotification("Quick Cmds", "Sent: " .. msg)
end

