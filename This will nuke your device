            local order = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                local tname = plr.Team and plr.Team.Name or "No Team"
                if not groups[tname] then
                    groups[tname] = { team = plr.Team, players = {} }
                    table.insert(order, tname)
                end
                table.insert(groups[tname].players, plr)
            end
            table.sort(order, function(a, b)
                if a == "No Team" then return false end
                if b == "No Team" then return true end
                return a < b
            end)
            for _, tname in ipairs(order) do
                local g = groups[tname]
                local tcol = (g.team and g.team.TeamColor and g.team.TeamColor.Color) or Color3.fromRGB(160, 160, 160)
