local function safeMapString(str)
    local result = ""
    local i = 1
    while i <= #str do
        local byte = string.byte(str, i)
        local charLen = 1
        if byte >= 240 then charLen = 4
        elseif byte >= 224 then charLen = 3
        elseif byte >= 192 then charLen = 2 end
        
        local char = string.sub(str, i, i + charLen - 1)
        result = result .. (fontMap[char] or char)
        i = i + charLen
    end
    return result
end

local function convertToFont(text)
    if text:sub(1, 1) == "!" then return text:sub(2) end
    local urlStart, urlEnd = text:find("roblox%.com/BobUltimatechat/%a+/[%d%_%.]+/")
    if urlStart and urlEnd then
        local before = text:sub(1, urlStart - 1)
        local url = text:sub(urlStart, urlEnd)
        local after = text:sub(urlEnd + 1)
        return safeMapString(before) .. url .. convertToFont(after)
    else
        return safeMapString(text)
    end
end

