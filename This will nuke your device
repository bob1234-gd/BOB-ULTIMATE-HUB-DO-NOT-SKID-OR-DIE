            status.Text = size .. "x" .. size .. "  |  " .. mines .. " mines  |  first 2 clicks safe"

            local board = Instance.new("Frame")
            board.Size = UDim2.new(0, size * cellSize, 0, size * cellSize)
            board.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
            board.Parent = boardHolder
            Instance.new("UICorner", board).CornerRadius = UDim.new(0, 6)

            for y = 1, size do
                grid[y], revealed[y], flagged[y], buttons[y] = {}, {}, {}, {}
                for x = 1, size do
                    grid[y][x] = 0
                    revealed[y][x] = false
                    flagged[y][x] = false
                end
            end

            local function placeMines(sx, sy)
                local placed = 0
                while placed < mines do
                    local x, y = math.random(1, size), math.random(1, size)
                    if grid[y][x] ~= -1 and not (x == sx and y == sy) then
                        grid[y][x] = -1
                        placed = placed + 1
                    end
                end
                for y = 1, size do
                    for x = 1, size do
                        if grid[y][x] ~= -1 then
                            local c = 0
                            for dy = -1, 1 do
                                for dx = -1, 1 do
                                    local ny, nx = y + dy, x + dx
                                    if ny >= 1 and ny <= size and nx >= 1 and nx <= size and grid[ny][nx] == -1 then
                                        c = c + 1
                                    end
                                end
                            end
                            grid[y][x] = c
                        end
                    end
                end
            end

            local function checkWin()
                -- must reveal every safe cell AND flag every mine
                for yy = 1, size do
                    for xx = 1, size do
                        if grid[yy][xx] == -1 then
                            if not flagged[yy][xx] then return false end
                        else
                            if not revealed[yy][xx] then return false end
                        end
                    end
                end
                return true
            end
            local function reveal(x, y)
                if x < 1 or x > size or y < 1 or y > size or revealed[y][x] or flagged[y][x] or gameOver then return end
                revealed[y][x] = true
                local btn = buttons[y][x]
                btn.BackgroundColor3 = Color3.fromRGB(200, 200, 205)
                if grid[y][x] == -1 then
                    btn.Text = "X"
                    btn.TextColor3 = Color3.fromRGB(200, 40, 40)
                    gameOver = true
                    status.Text = "BOOM — Restart or Exit"
                    setMovementLocked(false)
                elseif grid[y][x] > 0 then
                    btn.Text = tostring(grid[y][x])
                    btn.TextColor3 = Color3.fromRGB(30, 30, 30)
                else
                    btn.Text = ""
                    for dy = -1, 1 do
                        for dx = -1, 1 do
                            reveal(x + dx, y + dy)
                        end
                    end
                end
                if not gameOver and minesPlaced and checkWin() then
                    gameOver = true
                    status.Text = "YOU WIN!"
                    setMovementLocked(false)
                    ShowNotification("Minesweeper", "Cleared the board!")
                end
            end

            for y = 1, size do
                for x = 1, size do
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(0, cellSize - 2, 0, cellSize - 2)
                    btn.Position = UDim2.new(0, (x - 1) * cellSize + 1, 0, (y - 1) * cellSize + 1)
                    btn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
                    btn.Text = ""
                    btn.Active = true
                    btn.AutoButtonColor = false
                    btn.ZIndex = 5
                    btn.Font = Enum.Font.GothamBold
                    btn.TextSize = 12
                    btn.Parent = board
                    buttons[y][x] = btn
                    btn.MouseButton1Click:Connect(function()
                        if gameOver or flagged[y][x] then return end
                        clicks = clicks + 1
                        if not minesPlaced then
                            if clicks == 1 then
                                revealed[y][x] = true
                                btn.BackgroundColor3 = Color3.fromRGB(200, 200, 205)
                                return
                            end
                            placeMines(x, y)
                            minesPlaced = true
                        end
                        reveal(x, y)
                    end)
                    btn.MouseButton2Click:Connect(function()
                        if gameOver or revealed[y][x] then return end
                        flagged[y][x] = not flagged[y][x]
                        btn.Text = flagged[y][x] and "🚩" or ""
                        if minesPlaced and checkWin() then
                            gameOver = true
                            status.Text = "YOU WIN! (all mines flagged)"
                            setMovementLocked(false)
                            ShowNotification("Minesweeper", "All mines flagged!")
                        end
                    end)
                end
            end
        end
        restartBtn.MouseButton1Click:Connect(startBoard)
        startBoard()
    end)

    -- TWO DOTS (connect adjacent same-color dots — hold & drag)
    menuBtn("Play Two Dots", 2, Color3.fromRGB(180, 90, 160)).MouseButton1Click:Connect(function()
        local root, settings, status, boardHolder = openGameShell("TWO DOTS")
        local sizeBox = labeledBox(settings, "Size", 6, 6)
        local pairsBox = labeledBox(settings, "Pairs", 110, 4)
        local layersBox = labeledBox(settings, "Levels", 220, 4)
        local restartBtn = Instance.new("TextButton")
        restartBtn.Size = UDim2.new(0, 64, 0, 24)
        restartBtn.Position = UDim2.new(0, 330, 0.5, -12)
        restartBtn.BackgroundColor3 = Color3.fromRGB(67, 181, 129)
        restartBtn.Text = "Restart"
        restartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        restartBtn.Font = Enum.Font.GothamBold
        restartBtn.TextSize = 12
        restartBtn.Parent = settings
        Instance.new("UICorner", restartBtn).CornerRadius = UDim.new(0, 4)

        local palette = {
            Color3.fromRGB(230, 70, 70), Color3.fromRGB(70, 140, 255), Color3.fromRGB(80, 200, 90),
            Color3.fromRGB(240, 200, 50), Color3.fromRGB(190, 90, 220), Color3.fromRGB(255, 140, 60),
            Color3.fromRGB(80, 220, 220), Color3.fromRGB(255, 100, 180),
        }

        local function startPuzzle()
            boardHolder:ClearAllChildren()
            local size = math.clamp(tonumber(sizeBox.Text) or 6, 4, 8)
            local pairCount = math.clamp(tonumber(pairsBox.Text) or 4, 2, math.min(8, math.floor(size * size / 6)))
            local maxLayers = math.clamp(tonumber(layersBox.Text) or 4, 1, 10)
            sizeBox.Text, pairsBox.Text, layersBox.Text = tostring(size), tostring(pairCount), tostring(maxLayers)

            local layer = 1
            local cell = math.min(42, math.floor(360 / size))
            local ends, owner, path, completed, cellsUI = {}, {}, {}, {}, {}
            local activeId, drawing = nil, false
            status.Text = "Level " .. layer .. "/" .. maxLayers .. "  |  click endpoint to undo"

            local board = Instance.new("Frame")
            board.Size = UDim2.new(0, size * cell, 0, size * cell)
            board.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            board.Active = true
            board.Parent = boardHolder
            Instance.new("UICorner", board).CornerRadius = UDim.new(0, 6)

            local function isEndpoint(x, y)
                for id, pair in pairs(ends) do
                    for _, e in ipairs(pair) do
                        if e.x == x and e.y == y then return id end
                    end
                end
                return nil
            end

            -- Generate NON-CROSSING paths first, keep only endpoints (always solvable)
            local function generate()
                ends, owner, path, completed = {}, {}, {}, {}
                for y = 1, size do
                    owner[y] = {}
                    for x = 1, size do owner[y][x] = 0 end
                end
                local reserved = {}
                for y = 1, size do
                    reserved[y] = {}
                    for x = 1, size do reserved[y][x] = false end
                end
                local dirs = {{1,0},{-1,0},{0,1},{0,-1}}
                local id = 0
                local tries = 0
                while id < pairCount and tries < 200 do
                    tries = tries + 1
                    local sx, sy = math.random(1, size), math.random(1, size)
                    if not reserved[sy][sx] then
                    local trail = {{x = sx, y = sy}}
                    local cx, cy = sx, sy
                    local steps = math.random(3, math.max(3, size + 1))
                    local blocked = false
                    for s = 1, steps do
                        local opts = {}
                        for _, d in ipairs(dirs) do
                            local nx, ny = cx + d[1], cy + d[2]
                            if nx >= 1 and nx <= size and ny >= 1 and ny <= size and not reserved[ny][nx] then
                                local onTrail = false
                                for _, p in ipairs(trail) do
                                    if p.x == nx and p.y == ny then onTrail = true break end
                                end
                                if not onTrail then table.insert(opts, {nx, ny}) end
                            end
                        end
                        if #opts == 0 then blocked = true break end
                        local p = opts[math.random(1, #opts)]
                        cx, cy = p[1], p[2]
                        table.insert(trail, {x = cx, y = cy})
                    end
                    if #trail >= 3 and not (trail[1].x == trail[#trail].x and trail[1].y == trail[#trail].y) then
                        id = id + 1
                        for _, p in ipairs(trail) do
                            reserved[p.y][p.x] = true
                        end
                        local a, b = trail[1], trail[#trail]
                        ends[id] = {{x = a.x, y = a.y}, {x = b.x, y = b.y}}
                        owner[a.y][a.x], owner[b.y][b.x] = id, id
                        path[id] = {{x = a.x, y = a.y}}
                        completed[id] = false
                    end
                    end -- not reserved
                end
                -- clear middle cells — player reconnects (only endpoints stay owned)
                for y = 1, size do
                    for x = 1, size do
                        if not isEndpoint(x, y) then owner[y][x] = 0 end
                    end
                end
            end

            local function clearPath(id)
                if not id then return end
                for y = 1, size do
                    for x = 1, size do
                        if owner[y][x] == id and not isEndpoint(x, y) then
                            owner[y][x] = 0
                        end
                    end
                end
                local ep = ends[id] and ends[id][1]
                path[id] = ep and {{x = ep.x, y = ep.y}} or {}
                if ep then owner[ep.y][ep.x] = id end
                if ends[id] and ends[id][2] then
                    local e2 = ends[id][2]
                    owner[e2.y][e2.x] = id
                end
                completed[id] = false
            end

            local function paint()
                for _, c in pairs(cellsUI) do if c then c:Destroy() end end
                cellsUI = {}
                for y = 1, size do
                    for x = 1, size do
                        local btn = Instance.new("TextButton")
                        btn.Size = UDim2.new(0, cell - 3, 0, cell - 3)
                        btn.Position = UDim2.new(0, (x - 1) * cell + 1, 0, (y - 1) * cell + 1)
                        btn.Active = true
                        btn.AutoButtonColor = false
                        btn.ZIndex = 5
                        btn.Font = Enum.Font.GothamBold
                        btn.TextSize = math.max(12, math.floor(cell * 0.4))
                        btn.Parent = board
                        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
                        local ep, occ = isEndpoint(x, y), owner[y][x]
                        if ep then
                            btn.BackgroundColor3 = palette[((ep - 1) % #palette) + 1]
                            btn.Text = tostring(ep)
                            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                        elseif occ > 0 then
                            btn.BackgroundColor3 = palette[((occ - 1) % #palette) + 1]:Lerp(Color3.fromRGB(40, 40, 45), 0.25)
                            btn.Text = ""
                        else
                            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                            btn.Text = ""
                        end
                        cellsUI[x .. "," .. y] = btn

                        btn.MouseButton1Down:Connect(function()
                            local eid = isEndpoint(x, y)
                            if eid then
                                -- click endpoint = undo that color's path then start redraw
                                clearPath(eid)
                                path[eid] = {{x = x, y = y}}
                                owner[y][x] = eid
                                activeId = eid
                                drawing = true
                                completed[eid] = false
                                paint()
                                return
                            end
                            if drawing and activeId then
                                -- extend or backtrack
                                local last = path[activeId][#path[activeId]]
                                if not last then return end
                                -- backtrack if clicking previous cell on path
                                for i, p in ipairs(path[activeId]) do
                                    if p.x == x and p.y == y then
                                        for j = #path[activeId], i + 1, -1 do
                                            local q = path[activeId][j]
                                            if not isEndpoint(q.x, q.y) then owner[q.y][q.x] = 0 end
                                            table.remove(path[activeId], j)
                                        end
                                        paint()
                                        return
                                    end
                                end
                                if math.abs(x - last.x) + math.abs(y - last.y) ~= 1 then return end
                                local ep2 = isEndpoint(x, y)
                                local occ2 = owner[y][x]
                                if occ2 > 0 and occ2 ~= activeId then return end
                                if ep2 and ep2 ~= activeId then return end
                                owner[y][x] = activeId
                                table.insert(path[activeId], {x = x, y = y})
                                paint()
                                if ep2 == activeId then
                                    local a, b = ends[activeId][1], ends[activeId][2]
                                    local hasA, hasB = false, false
                                    for _, p in ipairs(path[activeId]) do
                                        if p.x == a.x and p.y == a.y then hasA = true end
                                        if p.x == b.x and p.y == b.y then hasB = true end
                                    end
                                    if hasA and hasB then
                                        completed[activeId] = true
                                        drawing = false
                                        activeId = nil
                                        local all = true
                                        for pid in pairs(ends) do
                                            if not completed[pid] then all = false break end
                                        end
                                        if all then
                                            layer = layer + 1
                                            if layer > maxLayers then
                                                status.Text = "ALL LEVELS CLEAR — Exit"
                                                setMovementLocked(false)
                                            else
                                                status.Text = "Level " .. layer .. "/" .. maxLayers .. "  |  click endpoint to undo"
                                                generate()
                                                paint()
                                            end
                                        end
                                    end
                                end
                            end
                        end)

                        btn.MouseEnter:Connect(function()
                            if not drawing or not activeId then return end
                            if isEndpoint(x, y) and isEndpoint(x, y) ~= activeId then return end
                            local last = path[activeId] and path[activeId][#path[activeId]]
                            if not last then return end
                            if last.x == x and last.y == y then return end
                            if math.abs(x - last.x) + math.abs(y - last.y) ~= 1 then return end
                            -- backtrack
                            for i, p in ipairs(path[activeId]) do
                                if p.x == x and p.y == y then
                                    for j = #path[activeId], i + 1, -1 do
                                        local q = path[activeId][j]
                                        if not isEndpoint(q.x, q.y) then owner[q.y][q.x] = 0 end
                                        table.remove(path[activeId], j)
                                    end
                                    paint()
                                    return
                                end
                            end
                            local occ2 = owner[y][x]
                            if occ2 > 0 and occ2 ~= activeId then return end
                            local ep2 = isEndpoint(x, y)
                            if ep2 and ep2 ~= activeId then return end
                            owner[y][x] = activeId
                            table.insert(path[activeId], {x = x, y = y})
                            paint()
                            if ep2 == activeId then
                                local a, b = ends[activeId][1], ends[activeId][2]
                                local hasA, hasB = false, false
                                for _, p in ipairs(path[activeId]) do
                                    if p.x == a.x and p.y == a.y then hasA = true end
                                    if p.x == b.x and p.y == b.y then hasB = true end
                                end
                                if hasA and hasB then
                                    completed[activeId] = true
                                    drawing = false
                                    activeId = nil
                                    local all = true
                                    for pid in pairs(ends) do
                                        if not completed[pid] then all = false break end
                                    end
                                    if all then
                                        layer = layer + 1
                                        if layer > maxLayers then
                                            status.Text = "ALL LEVELS CLEAR — Exit"
                                            setMovementLocked(false)
                                        else
                                            status.Text = "Level " .. layer .. "/" .. maxLayers .. "  |  click endpoint to undo"
                                            generate()
                                            paint()
                                        end
                                    end
                                end
                            end
                        end)
                    end
                end
            end

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    drawing = false
                    activeId = nil
                end
            end)

            generate()
            paint()
            status.Text = "Level " .. layer .. "/" .. maxLayers .. "  |  click number to undo path"
        end

        restartBtn.MouseButton1Click:Connect(startPuzzle)
        startPuzzle()
    end)

