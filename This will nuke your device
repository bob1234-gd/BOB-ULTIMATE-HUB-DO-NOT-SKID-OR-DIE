            handRow.Parent = boardHolder
            local lay = Instance.new("UIListLayout")
            lay.FillDirection = Enum.FillDirection.Horizontal
            lay.Padding = UDim.new(0, 4)
            lay.Parent = handRow

            local function playCardFromHand(idx)
                if winner or turn ~= 1 then return end
                local card = hands[1][idx]
                if not card or not canPlay(card, top()) then
                    status.Text = "Can't play that"
                    return
                end
                table.remove(hands[1], idx)
                if card.wild then
                    local counts = {R = 0, B = 0, G = 0, Y = 0}
                    for _, x in ipairs(hands[1]) do
                        if x.color then counts[x.color] = counts[x.color] + 1 end
                    end
                    local best, bn = "R", -1
                    for k, v in pairs(counts) do if v > bn then best, bn = k, v end end
                    card.color = best
                    status.Text = "Wild → " .. best
                end
                table.insert(pile, card)
                if mode == "MP" then
                    gameMPSend(string.format("U%s:%d:%s", room, idx, cardId(card)))
                end
                applyEffect(1, card)
                paint()
                if #hands[1] == 0 then
                    winner = 1
                    status.Text = "YOU WIN! UNO!"
                    return
                end
                if turn ~= 1 then task.delay(0.35, aiTurns) end
            end

            for i, c in ipairs(hands[1]) do
                local host = Instance.new("TextButton")
                host.Size = UDim2.new(0, 58, 0, 100)
                host.BackgroundTransparency = 1
                host.Text = ""
                host.AutoButtonColor = false
                host.ZIndex = 5
                host.Parent = handRow
                local face = makePixelCard(host, c, 58, 88)
                face.ZIndex = 4
                for _, d in ipairs(face:GetDescendants()) do
                    if d:IsA("GuiObject") then
                        d.Active = false
                        d.ZIndex = 4
                    end
                end
                local idx = i
                host.MouseButton1Click:Connect(function()
                    -- play anim: fly up then resolve
                    TweenService:Create(host, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = host.Position - UDim2.new(0, 0, 0, 24)
                    }):Play()
                    task.delay(0.16, function()
                        playCardFromHand(idx)
                    end)
                end)
            end

            -- Deck (pick up / draw) + Draw button
            local deckBtn = Instance.new("TextButton")
            deckBtn.Size = UDim2.new(0, 64, 0, 96)
            deckBtn.Position = UDim2.new(0.5, -110, 0, 48)
            deckBtn.BackgroundColor3 = Color3.fromRGB(30, 35, 55)
            deckBtn.Text = "DECK\n" .. tostring(#deck)
            deckBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            deckBtn.Font = Enum.Font.GothamBold
            deckBtn.TextSize = 12
            deckBtn.ZIndex = 6
            deckBtn.Parent = boardHolder
            Instance.new("UICorner", deckBtn).CornerRadius = UDim.new(0, 8)
            local function doDraw()
                if winner or turn ~= 1 then return end
                local drawn = drawOne(1)
                if not drawn then status.Text = "Deck empty" return end
                status.Text = "Drew a card"
                -- brief scale pop
                TweenService:Create(deckBtn, TweenInfo.new(0.12), {Size = UDim2.new(0, 70, 0, 102)}):Play()
                task.delay(0.12, function()
                    TweenService:Create(deckBtn, TweenInfo.new(0.12), {Size = UDim2.new(0, 64, 0, 96)}):Play()
                end)
                turn = nextSeat(1)
                paint()
                if mode == "AI" and turn ~= 1 then task.delay(0.3, aiTurns) end
            end
            deckBtn.MouseButton1Click:Connect(doDraw)

            local drawBtn = Instance.new("TextButton")
            drawBtn.Size = UDim2.new(0, 80, 0, 28)
            drawBtn.Position = UDim2.new(0, 8, 0, 290)
            drawBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
            drawBtn.Text = "Draw"
            drawBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            drawBtn.Font = Enum.Font.GothamBold
            drawBtn.TextSize = 12
            drawBtn.ZIndex = 6
            drawBtn.Parent = boardHolder
            Instance.new("UICorner", drawBtn).CornerRadius = UDim.new(0, 4)
            drawBtn.MouseButton1Click:Connect(doDraw)
        end

        function aiTurns()
            if winner or mode ~= "AI" then return end
            while turn ~= 1 and not winner do
                local seat = turn
                local hand = hands[seat]
                local playIdx = nil
                for i, c in ipairs(hand) do
                    if canPlay(c, top()) then
                        playIdx = i
                        if c.val == "D" or c.val == "S" or c.wild4 then break end
                    end
                end
                if playIdx then
                    local card = table.remove(hand, playIdx)
                    if card.wild then
                        local counts = {R = 0, B = 0, G = 0, Y = 0}
                        for _, x in ipairs(hand) do
                            if x.color then counts[x.color] = counts[x.color] + 1 end
                        end
                        local best, bn = "R", -1
                        for k, v in pairs(counts) do if v > bn then best, bn = k, v end end
                        card.color = best
                    end
                    table.insert(pile, card)
                    applyEffect(seat, card)
                    status.Text = string.format("P%d played %s", seat, cardLabel(card))
                    if #hand == 0 then
                        winner = seat
                        status.Text = "P" .. seat .. " wins!"
                        paint()
                        return
                    end
                else
                    drawOne(seat)
                    turn = nextSeat(seat)
                    status.Text = "P" .. seat .. " drew"
                end
                paint()
                task.wait(0.25)
            end
        end

        local function deal()
            deck = buildDeck()
            hands = {}
            for s = 1, 4 do hands[s] = {} end
            pile = {}
            turn = 1
            dir = 1
            winner = nil
            for s = 1, numPlayers do
                for _ = 1, 7 do drawOne(s) end
            end
            while true do
                local c = table.remove(deck)
                if c and not c.wild then table.insert(pile, c) break end
                if c then table.insert(deck, c) end
                if #deck == 0 then break end
            end
            paint()
            status.Text = "Pixel UNO — " .. numPlayers .. " players. Match color or number."
        end

        dealBtn.MouseButton1Click:Connect(deal)
        deal()
    end)

