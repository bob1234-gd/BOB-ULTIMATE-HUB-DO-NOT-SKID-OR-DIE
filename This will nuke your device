            for _, m in ipairs(legalMoves(fx, fy)) do
                if m.x == tx and m.y == ty then ok = true break end
            end
            if not ok then return false end
            board[ty][tx] = p
            board[fy][fx] = ""
            if p:sub(2,2) == "P" and (ty == 1 or ty == 8) then
                board[ty][tx] = side .. "Q"
            end
            turn = (turn == "w") and "b" or "w"
            -- Short code: rankFile-rankFile e.g. 2A-4A (not full board dump)
            local function sq(x, y)
                return tostring(9 - y) .. string.char(64 + x) -- 1A..8H
            end
            if mode == "MP" then
                gameMPSend(string.format("C%s:%s-%s", room, sq(fx, fy), sq(tx, ty)))
            end
            paint()
            if not hasKing("b") then
                status.Text = "White wins! (King captured)"
                return true
            end
            if mode == "AI" and turn == "b" then
                task.delay(0.35, runAI)
            end
