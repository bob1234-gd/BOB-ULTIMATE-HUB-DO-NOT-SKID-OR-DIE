local function StartSignSweep()
    task.spawn(function()
        for tpX = mapMin, mapMax, teleportStep do
            for tpZ = mapMin, mapMax, teleportStep do
                
                if not _G.SignPlacerRunning then return end
                
                local char = LocalPlayer.Character
                if not char then task.wait(1); continue end
                
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                
                if not root or not hum or hum.Health <= 0 then
                    task.wait(1)
                    continue
                end

                local tool = getActiveTool(char, "Sign")
                if not tool then
                    task.wait(1)
                    continue
                end

                if tool.Parent ~= char then
                    hum:EquipTool(tool)
                    task.wait(0.4) 
                end

                local remote = tool:FindFirstChild("Event", true)
                if not remote then continue end

                local checkOrigin = Vector3.new(tpX, 500, tpZ)
                local rayParams = RaycastParams.new()
                rayParams.FilterDescendantsInstances = {char, tool}
                rayParams.FilterType = Enum.RaycastFilterType.Exclude

                local groundHit = Workspace:Raycast(checkOrigin, Vector3.new(0, -1000, 0), rayParams)
                
                if groundHit and groundHit.Instance then
                    local groundPos = groundHit.Position
                    
                    local teleportElevation = math.max(4, (currentStackHeight * signHeightOffset) * 0.5)
                    char:PivotTo(CFrame.new(groundPos + Vector3.new(0, teleportElevation, 0)))
                    root.Velocity = Vector3.zero
                    
                    task.wait(0.5)

                    local halfStep = teleportStep / 2
                    for signX = -halfStep, halfStep, signSpacing do
                        if not _G.SignPlacerRunning then return end
                        for signZ = -halfStep, halfStep, signSpacing do
                            
                            if tool.Parent ~= char then break end

                            local castStartHeight = (currentStackHeight * signHeightOffset) + 10
                            local signRayOrigin = Vector3.new(groundPos.X + signX, groundPos.Y + castStartHeight, groundPos.Z + signZ)
                            local signHit = Workspace:Raycast(signRayOrigin, Vector3.new(0, -castStartHeight - 20, 0), rayParams)
                            
                            if signHit and signHit.Instance then
                                for i = 0, currentStackHeight - 1 do
                                    if not _G.SignPlacerRunning or tool.Parent ~= char then break end
                                    
                                    local stackPos = signHit.Position + Vector3.new(0, i * signHeightOffset, 0)
                                    remote:FireServer(signHit.Instance, Enum.NormalId.Top, stackPos)
                                    task.wait(0.01)
                                end
                            end
