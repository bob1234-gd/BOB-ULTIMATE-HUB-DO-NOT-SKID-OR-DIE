    local function sendChatMessage(message)
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannel = TextChatService.TextChannels.RBXGeneral
            if textChannel then
                textChannel:SendAsync(message)
            end
        else
            local defaultChatSystem = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if defaultChatSystem then
                local sayMessageRequest = defaultChatSystem:FindFirstChild("SayMessageRequest")
                if sayMessageRequest then
                    sayMessageRequest:FireServer(message, "All")
                end
            end
        end
        task.wait(1.1)
    end

    local function waitForChatResponse(activePrompt, targetPlayer, timeout)
        timeout = timeout or 99999999
        local answered = false
        local response = ""
        local fromPlayer = nil
        local connection
        local startTime = tick()

        local function onMessage(text, sender)
            if not text or not sender or sender == localPlayer then return end
            text = tostring(text)

            if text == activePrompt or text:lower():find(activePrompt:lower(), 1, true) then
                return
            end

            if targetPlayer and sender ~= targetPlayer then
                return
            end

            response = text
            fromPlayer = sender
            answered = true
        end

        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannel = TextChatService.TextChannels.RBXGeneral
            if textChannel then
                connection = textChannel.MessageReceived:Connect(function(textMessage)
                    if textMessage.TextSource then
                        local sender = Players:GetPlayerByUserId(textMessage.TextSource.UserId)
                        onMessage(textMessage.Text, sender)
                    end
                end)
            end
        else
            local defaultChatSystem = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            if defaultChatSystem then
                local onMessageDoneFiltering = defaultChatSystem:FindFirstChild("OnMessageDoneFiltering")
                if onMessageDoneFiltering then
                    connection = onMessageDoneFiltering.OnClientEvent:Connect(function(messageData)
                        local sender = Players:FindFirstChild(messageData.FromSpeaker)
                        onMessage(messageData.Message, sender)
                    end)
                end
            end
        end

        task.wait(0.35)

        while not answered and (tick() - startTime) < timeout do
            task.wait(0.1)
        end

        if connection then
            connection:Disconnect()
        end

        if not answered then
            return nil, nil
        end

        return response:lower():gsub("^%s*(.-)%s*$", "%1"), fromPlayer
    end

