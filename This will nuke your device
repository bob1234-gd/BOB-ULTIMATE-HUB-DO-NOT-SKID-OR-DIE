-- Load remote map DATA via loadstring (defines globals like BobsLobby, GRIEVING_DATA, etc.)
-- NOTE: "Maps..." with the three dots IS the real filename on GitHub
local MAPS_LOADSTRING_URL = "https://raw.githubusercontent.com/bob1234-gd/BOB-ULTIMATE-HUB-DO-NOT-SKID-OR-DIE/refs/heads/main/Maps..."
local mapsDataLoaded = false
local mapsCache = {} -- name -> data string

local function loadMapsData()
    if mapsDataLoaded then return true end
    local ok, err = pcall(function()
        local src = game:HttpGet(MAPS_LOADSTRING_URL)
        if not src or #src < 20 then error("empty response from Maps...") end
        local fn, loadErr = loadstring(src)
        if not fn then error(loadErr or "loadstring failed") end
        local ret = fn()
        local env = (getgenv and getgenv()) or _G
        -- if module returns a table of maps, cache them
        if type(ret) == "table" then
            for k, v in pairs(ret) do
                if type(v) == "string" or type(v) == "number" then
                    mapsCache[k] = tostring(v)
                    env[k] = tostring(v)
                end
            end
        end
        -- copy common map globals from env / _G into cache
        local names = {"BobsLobby", "GRIEVING_DATA", "CozyTown_DATA", "MyBuunParadise_DATA", "Gastermap"}
        for _, n in ipairs(names) do
            local v = env[n] or _G[n]
            if v ~= nil and tostring(v) ~= "" then
                mapsCache[n] = tostring(v)
                env[n] = tostring(v)
                _G[n] = tostring(v)
            end
        end
    end)
    if ok then
        mapsDataLoaded = true
        ShowNotification("Maps", "Map data loaded from Maps...")
        return true
    end
    warn("[Maps] loadstring failed:", err)
    ShowNotification("Maps", "Failed to load Maps...: " .. tostring(err))
    return false
end

local function getMapVar(name)
    if mapsCache[name] and mapsCache[name] ~= "" then return mapsCache[name] end
    if getgenv then
        local g = getgenv()
        if g and g[name] ~= nil then return tostring(g[name]) end
    end
    if _G[name] ~= nil then return tostring(_G[name]) end
    return nil
end

local function loadMapIntoBuilder(varName, displayName)
    if not loadMapsData() then return end
    local data = getMapVar(varName)
    if not data or data == "" then
        ShowNotification("Error", "Map data '" .. varName .. "' not found after loadstring.")
        return
    end
    local box = _G.ABTextBox
    if not box then
        -- try find Auto Builder textbox again
        ShowNotification("Error", "Auto Builder not ready — open Auto Builder tab first.")
        return
    end
    box.Text = tostring(data)
    ShowNotification("Maps", (displayName or varName) .. " loaded into Auto Builder.")
end

