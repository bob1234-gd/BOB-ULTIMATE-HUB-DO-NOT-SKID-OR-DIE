local NOM_ANIM_ID = "rbxassetid://121394473554828"
local nomToolRef = nil

local function getDeleteRemoteForNom()
    local char = LocalPlayer.Character
    local tool = getActiveTool(char, "Delete")
    if not tool then return nil, nil end
    local remote = tool:FindFirstChild("Event", true) or tool:FindFirstChildOfClass("RemoteEvent")
    return tool, remote
end

local function deleteBlocksInFront(count, nomTool)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    local deleteTool, remote = getDeleteRemoteForNom()
    if not deleteTool or not remote then
        ShowNotification("Nom", "Need the Delete tool!")
        return
    end
    if hum and deleteTool.Parent ~= char then
        pcall(function() hum:EquipTool(deleteTool) end)
        task.wait(0.12)
    end

    local bricksFolder = Workspace:FindFirstChild("Bricks")
    local look = hrp.CFrame.LookVector
    local right = hrp.CFrame.RightVector
    local pos = hrp.Position

    -- Frontal volume: in front of you, wide enough, from feet to above head
    local maxDist = 10
    local halfWidth = 3.5
    local yMin = pos.Y - 4.5   -- legs / feet
    local yMax = pos.Y + 4.5   -- above head

    local targets = {}
    local source = bricksFolder or Workspace
    for _, desc in ipairs(source:GetDescendants()) do
        if desc:IsA("BasePart") then
            local p = desc.Position
            local to = p - pos
            local forward = to:Dot(look)
            if forward > 0.4 and forward <= maxDist then
                local lateral = math.abs(to:Dot(right))
                if lateral <= halfWidth and p.Y >= yMin and p.Y <= yMax then
                    table.insert(targets, {part = desc, dist = forward})
                end
            end
        end
    end
    table.sort(targets, function(a, b) return a.dist < b.dist end)

    local deleted = 0
    local limit = count or 999
    for _, item in ipairs(targets) do
        if deleted >= limit then break end
        local part = item.part
        if part and part.Parent then
            -- step near the part so server range checks pass
            pcall(function()
                char:PivotTo(CFrame.new(part.Position + Vector3.new(0, 3, 0)))
                hrp.AssemblyLinearVelocity = Vector3.zero
            end)
            task.wait(0.03)
            pcall(function()
                remote:FireServer(part, part.Position)
            end)
            task.wait(0.025)
            pcall(function()
                remote:FireServer(part, part.Position)
            end)
            deleted = deleted + 1
        end
    end

    -- Return to roughly original facing position
    pcall(function()
        char:PivotTo(CFrame.new(pos) * (hrp.CFrame - hrp.CFrame.Position))
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)

    -- Unequip Delete, re-equip Nom
    if hum then
        task.wait(0.05)
        pcall(function() hum:UnequipTools() end)
        task.wait(0.05)
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local nom = nomTool
            or (char:FindFirstChild("Nom"))
            or (backpack and backpack:FindFirstChild("Nom"))
        if nom and nom:IsA("Tool") then
            -- strip any Handle if present
            local h = nom:FindFirstChild("Handle")
            if h then pcall(function() h:Destroy() end) end
            nom.RequiresHandle = false
            pcall(function() hum:EquipTool(nom) end)
        end
    end
end

local function setupNomTool(tool)
    if tool:GetAttribute("NomHooked") then return end
    tool:SetAttribute("NomHooked", true)
    tool.Activated:Connect(function()
        if not isR15() then
            ShowNotification("Nom", "R15 required.")
            return
        end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = hum
        end

        local anim = Instance.new("Animation")
        anim.AnimationId = NOM_ANIM_ID
        local track
        local ok = pcall(function()
            track = animator:LoadAnimation(anim)
            track.Priority = Enum.AnimationPriority.Action4
            track.Looped = false
            track:Play(0.05, 1, 1)
        end)
        if not ok or not track then
            ShowNotification("Nom", "Failed to play anim.")
            deleteBlocksInFront(50, tool)
            return
        end

        -- at 0.35s: equip delete + delete 2 blocks in front, then unequip delete / re-equip Nom
        task.delay(0.35, function()
            if not isR15() then return end
            deleteBlocksInFront(50, tool)
        end)

        -- stop anim at 0.53s and make sure Nom is back, Delete is not equipped
        task.delay(0.53, function()
            pcall(function()
                if track then
                    track:Stop(0)
                    track:AdjustWeight(0)
                    track:Destroy()
                end
            end)
            -- kill leftover tool/arm poses
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if h then
                local animator2 = h:FindFirstChildOfClass("Animator")
                if animator2 then
                    for _, tr in ipairs(animator2:GetPlayingAnimationTracks()) do
                        if tr.Animation and tostring(tr.Animation.AnimationId):find("121394473554828") then
                            pcall(function() tr:Stop(0) end)
                        end
                    end
                end
                local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
