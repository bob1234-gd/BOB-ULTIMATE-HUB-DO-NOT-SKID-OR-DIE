            return
        end

        local hum = char:FindFirstChild("Humanoid")
        if hum and deleteTool.Parent ~= char then
            hum:EquipTool(deleteTool)
            task.wait(0.4)
        end

        local originalPos = root.CFrame
        -- Adaptive timing: MORE blocks = FASTER, FEWER blocks = slower/careful (no misses)
        local function getDeleteTiming(count)
            if count >= 400 then
                return 0.025, 0.012, 1, 0.15   -- tp, fire, firesPerPart, passPause
            elseif count >= 150 then
                return 0.04, 0.02, 2, 0.2
            elseif count >= 50 then
                return 0.06, 0.035, 2, 0.28
            else
                return 0.09, 0.055, 3, 0.4     -- careful when few left
            end
        end
        local maxPasses = 25
        local pass = 0
        local emptyStreak = 0

        while isDeleting and pass < maxPasses do
            pass = pass + 1
            local foundParts = {}
            for _, folder in ipairs(foldersToScan) do
                if folder and folder.Parent then
                    for _, desc in ipairs(folder:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            table.insert(foundParts, desc)
                        end
                    end
                end
            end

            if #foundParts == 0 then
                emptyStreak = emptyStreak + 1
                if emptyStreak >= 2 then
                    break -- two clean scans in a row
                end
                task.wait(0.3)
                continue
            end
            emptyStreak = 0

            local TP_WAIT, FIRE_WAIT, firesPerPart, PASS_PAUSE = getDeleteTiming(#foundParts)

            -- Re-equip if needed
            char = LocalPlayer.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            hum = char and char:FindFirstChild("Humanoid")
            deleteTool = getActiveTool(char, "Delete")
            if deleteTool and hum and deleteTool.Parent ~= char then
                pcall(function() hum:EquipTool(deleteTool) end)
                task.wait(0.25)
                remote = deleteTool:FindFirstChild("Event", true) or deleteTool:FindFirstChildOfClass("RemoteEvent")
            end
            if not root or not remote then
                task.wait(0.2)
                continue
            end

            for _, part in ipairs(foundParts) do
                if not isDeleting then break end
                if part and part.Parent then
                    pcall(function()
                        char:PivotTo(part.CFrame + Vector3.new(0, 5, 0))
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end)
                    task.wait(TP_WAIT)

                    for _ = 1, firesPerPart do
                        if not isDeleting or not part.Parent then break end
                        pcall(function()
                            remote:FireServer(part, part.Position)
                        end)
                        task.wait(FIRE_WAIT)
                    end
                end
            end

            task.wait(PASS_PAUSE)
        end

        if isDeleting then
            isDeleting = false
            pcall(function()
                if char and originalPos then char:PivotTo(originalPos) end
            end)
            ShowNotification("Deletion Sweeper", "Finished deletion sweep!")
            if StartDeleteBtn then
                StartDeleteBtn.Text = "Start Map Wipe"
                StartDeleteBtn.TextColor3 = Color3.fromRGB(220, 221, 222)
            end
        end
    end)
end

