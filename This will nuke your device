---------------------------------------------------------
local function applyScreenAdapter(guiObject)
    local uiScale = Instance.new("UIScale")
    uiScale.Parent = guiObject
    
    local function updateScale()
        local viewport = workspace.CurrentCamera.ViewportSize
        if viewport.X < 800 or viewport.Y < 600 then
            local scaleFactor = math.min(viewport.X / 800, viewport.Y / 600)
            uiScale.Scale = math.clamp(scaleFactor, 0.6, 1) 
        else
            uiScale.Scale = 1 
        end
    end
    
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
    updateScale()
    return uiScale
end

