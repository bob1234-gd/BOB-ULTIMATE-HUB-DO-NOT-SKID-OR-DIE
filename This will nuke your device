local function sendDetectorChat(message)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local textChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if textChannel then
            pcall(function() textChannel:SendAsync(message) end)
            return
        end
    end
    local defaultChatSystem = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if defaultChatSystem then
        local sayMessageRequest = defaultChatSystem:FindFirstChild("SayMessageRequest")
        if sayMessageRequest then
            pcall(function() sayMessageRequest:FireServer(message, "All") end)
        end
    end
end

local function isWhitelisted(plr)
    return plr and whitelist[plr.UserId] == true
end

local function trackTools()
    local now = tick()
    for _, plr in ipairs(Players:GetPlayers()) do
        local pChar = plr.Character
        if not pChar then continue end
        recentToolUsers[plr.UserId] = recentToolUsers[plr.UserId] or {}
        if pChar:FindFirstChild("Delete") then recentToolUsers[plr.UserId].Delete = now end
        if pChar:FindFirstChild("Paint") then recentToolUsers[plr.UserId].Paint = now end
        if pChar:FindFirstChild("Build") then recentToolUsers[plr.UserId].Build = now end
        if pChar:FindFirstChild("Sign") then recentToolUsers[plr.UserId].Sign = now end
    end
    for uid, tools in pairs(recentToolUsers) do
        for tool, t in pairs(tools) do
            if now - t > 12 then tools[tool] = nil end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if deleteDetectorEnabled or paintDetectorEnabled or spamBuildEnabled or spamSignEnabled then
            trackTools()
        end
    end
end)

local function findSuspects(toolName, brickPos, ownerName)
    local suspects = {}
    local now = tick()
    for _, plr in ipairs(Players:GetPlayers()) do
        if isWhitelisted(plr) then continue end
        if plr.Name == ownerName or plr.DisplayName == ownerName then continue end

        local pChar = plr.Character
        local hasNow = pChar and pChar:FindFirstChild(toolName) ~= nil
        local rec = recentToolUsers[plr.UserId]
        local hadRecently = rec and rec[toolName] and (now - rec[toolName] < 8)

        if hasNow or hadRecently then
            local dist = math.huge
            if pChar then
                local hrp = pChar:FindFirstChild("HumanoidRootPart")
                if hrp and brickPos then
                    dist = (hrp.Position - brickPos).Magnitude
                end
            end
            table.insert(suspects, {
                player = plr,
                dist = dist,
                remote = dist > 50 or dist == math.huge,
                active = hasNow
            })
        end
    end
    table.sort(suspects, function(a, b)
        if a.active ~= b.active then return a.active end
        return a.dist < b.dist
    end)
    return suspects
end

