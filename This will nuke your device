    "smooth", "plastic", "tiles", "bricks", "planks", "ice", "grass", "sand",
    "glass", "wood", "stone", "pebble", "marble", "granite", "steel", "metal",
    "asphalt", "concrete", "pavement", "toxic", "neon", "snow", "glitched_neon"
}
local GLITCH_NEON_COL = Color3.new(-9223372036854775808, -9223372036854775808, -9223372036854775808)

-- ========== HELPERS ==========
local function getPaintTool()
    return getActiveTool(LocalPlayer.Character, "Paint")
end

local function getPaintRemote(tool)
    if not tool then return nil end
    local scr = tool:FindFirstChild("Script") or tool:FindFirstChildWhichIsA("LocalScript") or tool:FindFirstChildWhichIsA("Script")
    if scr then
        return scr:FindFirstChild("Event") or scr:FindFirstChildOfClass("RemoteEvent")
    end
    return tool:FindFirstChild("Event", true) or tool:FindFirstChildOfClass("RemoteEvent")
end

local function ensurePaintEquipped(tool)
    local char = LocalPlayer.Character
    if not char or not tool then return false end
    if tool.Parent == char then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:EquipTool(tool) end)
        task.wait(0.35)
        return tool.Parent == char
    end
    return false
end

-- FireServer(Target, Surface, Pos, mode, color, material, spray)
local function firePaint(remote, part, mode, color, material, spray)
    if not remote or not part or not part.Parent then return end
    pcall(function()
        remote:FireServer(part, Enum.NormalId.Top, part.Position, mode, color, material or "", spray or "")
    end)
end

local function paintOne(remote, part)
    local mat = paintMaterial
    local spray = paintSprayText or ""
    local col = paintColor
    -- Glitched neon: neon material first (this part works), then glitch color + light tries
    if mat == "glitched_neon" then
        local gcol = GLITCH_NEON_COL
        -- 1) force neon material with a visible color so server accepts material change
        firePaint(remote, part, "material", Color3.fromRGB(255, 255, 255), "neon", "")
        firePaint(remote, part, "both 🤝", Color3.fromRGB(255, 255, 255), "neon", "")
        -- 2) glitch color (huge negatives) on color + both
        firePaint(remote, part, "color", gcol, "", "")
        firePaint(remote, part, "color", gcol, "neon", "")
        firePaint(remote, part, "both 🤝", gcol, "neon", "")
        firePaint(remote, part, "material", gcol, "neon", "")
        -- 3) FE light-style material names some TCO builds accept
        for _, lightMat in ipairs({"neon", "light", "pointlight", "glow", "lamp"}) do
            firePaint(remote, part, "material", gcol, lightMat, "")
            firePaint(remote, part, "both 🤝", gcol, lightMat, "")
            firePaint(remote, part, "light", gcol, lightMat, "")
        end
        -- 4) all faces color push (same pattern as spray)
        for _, face in ipairs({
            Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front,
            Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right
        }) do
            pcall(function()
                remote:FireServer(part, face, part.Position, "both 🤝", gcol, "neon", "")
            end)
            pcall(function()
                remote:FireServer(part, face, part.Position, "color", gcol, "neon", "")
            end)
        end
        return
    end
    -- Color
    firePaint(remote, part, "color", col, "", "")
    firePaint(remote, part, "color", col, mat, "")
    -- Material
    firePaint(remote, part, "material", col, mat, "")
    -- Both (color + material)
    firePaint(remote, part, "both 🤝", col, mat, "")
    -- Spray: TCO expects material field "spray" and text in last arg, often on all faces
    if spray ~= "" then
        local faces = {
            Enum.NormalId.Top, Enum.NormalId.Bottom,
            Enum.NormalId.Front, Enum.NormalId.Back,
            Enum.NormalId.Left, Enum.NormalId.Right
        }
        for _, face in ipairs(faces) do
            pcall(function()
                remote:FireServer(part, face, part.Position, "both 🤝", col, "spray", spray)
            end)
            pcall(function()
                remote:FireServer(part, face, part.Position, "material", col, "spray", spray)
            end)
        end
    end
end

-- Resolved when you click someone in the Custom list
local selectedPaintTargetName = nil -- exact Roblox Name
local selectedPaintTargetPlr = nil

local function findBricksFolderForPlayer(plrOrName)
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    if not bricksFolder then return nil end
    local plr = typeof(plrOrName) == "Instance" and plrOrName:IsA("Player") and plrOrName or nil
    local name = plr and plr.Name or tostring(plrOrName or "")
    local display = plr and plr.DisplayName or name
    local uid = plr and tostring(plr.UserId) or nil
    -- try common folder names TCO uses
    local tries = {name, display, uid}
    for _, key in ipairs(tries) do
        if key and key ~= "" then
            local f = bricksFolder:FindFirstChild(key)
            if f then return f end
        end
    end
    -- case-insensitive / partial
    local lower = string.lower(name)
    local lowerD = string.lower(display)
    for _, child in ipairs(bricksFolder:GetChildren()) do
        local cn = string.lower(child.Name)
        if cn == lower or cn == lowerD then return child end
        if plr and (cn == string.lower(plr.Name) or cn == string.lower(plr.DisplayName)) then return child end
    end
    return nil
end

local function collectTargets()
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    if not bricksFolder then return nil, "Bricks folder not found!" end
    local folders = {}
    if paintTargetMode == 1 then
        local myFolder = findBricksFolderForPlayer(LocalPlayer) or bricksFolder:FindFirstChild(LocalPlayer.Name)
        if not myFolder then return nil, "Could not find your folder!" end
        table.insert(folders, myFolder)
    elseif paintTargetMode == 2 then
        for _, child in ipairs(bricksFolder:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Model") then
                table.insert(folders, child)
            end
        end
    else
        local plr = selectedPaintTargetPlr
        local name = selectedPaintTargetName
            or (PaintCustomBox and PaintCustomBox.Text)
            or ""
        name = tostring(name):gsub("^%s+", ""):gsub("%s+$", "")
        if (not plr) and name ~= "" then
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == string.lower(name)
                    or string.lower(p.DisplayName) == string.lower(name) then
                    plr = p
                    name = p.Name
                    break
                end
            end
        end
        if name == "" and not plr then
            return nil, "Pick a player from the list first."
        end
        local f = findBricksFolderForPlayer(plr or name)
        if not f then
            return nil, "No bricks folder for " .. (plr and plr.Name or name) .. " (they may have 0 blocks)."
        end
        table.insert(folders, f)
    end
    local parts = {}
    for _, folder in ipairs(folders) do
        for _, desc in ipairs(folder:GetDescendants()) do
            if desc:IsA("BasePart") then
                table.insert(parts, desc)
            end
        end
    end
    return parts, nil
end

local function collectAllBricks()
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    if not bricksFolder then return {} end
    local parts = {}
    for _, desc in ipairs(bricksFolder:GetDescendants()) do
        if desc:IsA("BasePart") then
            table.insert(parts, desc)
        end
    end
    return parts
end


