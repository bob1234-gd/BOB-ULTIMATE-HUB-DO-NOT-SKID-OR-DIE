-- ---------- Spam Build / Sign Detectors ----------
-- Counts rapid ChildAdded of Brick / Sign-related parts
local spamBuildCounts = {} -- [userId] = {count, windowStart}
local spamSignCounts = {}
local SPAM_THRESHOLD = 12 -- placements within window
local SPAM_WINDOW = 3 -- seconds

local spamConnections = {}

local function disconnectSpamWatchers()
    for _, c in ipairs(spamConnections) do if c then c:Disconnect() end end
    table.clear(spamConnections)
end

local function setupSpamWatchers()
    disconnectSpamWatchers()
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    if not bricksFolder then return end

    local function onBrickAdded(desc, ownerName)
        if not desc:IsA("BasePart") then return end
        local now = tick()

        -- Spam Build: rapid Brick additions
        if spamBuildEnabled and desc.Name == "Brick" then
            local owner = Players:FindFirstChild(ownerName)
            if owner and not isWhitelisted(owner) then
                local uid = owner.UserId
                local data = spamBuildCounts[uid]
                if not data or now - data.windowStart > SPAM_WINDOW then
                    spamBuildCounts[uid] = {count = 1, windowStart = now}
                else
                    data.count = data.count + 1
                    if data.count >= SPAM_THRESHOLD and now - lastSpamBuildAlertTime >= detectorCooldown then
                        lastSpamBuildAlertTime = now
                        local msg = string.format("[Spam Build] %s is spam-building! (%d in %.0fs)", ownerName, data.count, SPAM_WINDOW)
                        sendDetectorChat(msg)
                        ShowNotification("Spam Build", msg)
                        data.count = 0
                        data.windowStart = now
                    end
                end
            end
        end

        -- Spam Sign: parts that look like signs, or rapid adds while Sign tool out
        if spamSignEnabled then
            local isSignLike = desc.Name:lower():find("sign") or desc:FindFirstChild("Sign") or desc:FindFirstChildOfClass("SurfaceGui")
            local owner = Players:FindFirstChild(ownerName)
            if owner and not isWhitelisted(owner) then
                local hasSign = owner.Character and owner.Character:FindFirstChild("Sign")
                local hadSign = recentToolUsers[owner.UserId] and recentToolUsers[owner.UserId].Sign
                    and now - recentToolUsers[owner.UserId].Sign < 5
                if isSignLike or hasSign or hadSign then
                    local uid = owner.UserId
                    local data = spamSignCounts[uid]
                    if not data or now - data.windowStart > SPAM_WINDOW then
                        spamSignCounts[uid] = {count = 1, windowStart = now}
                    else
                        data.count = data.count + 1
                        if data.count >= SPAM_THRESHOLD and now - lastSpamSignAlertTime >= detectorCooldown then
                            lastSpamSignAlertTime = now
                            local msg = string.format("[Spam Sign] %s is spam-placing signs! (%d in %.0fs)", ownerName, data.count, SPAM_WINDOW)
                            sendDetectorChat(msg)
                            ShowNotification("Spam Sign", msg)
                            data.count = 0
                            data.windowStart = now
                        end
                    end
                end
            end
        end
    end

    local function watchFolder(folder)
        if not folder then return end
        local ownerName = folder.Name
        table.insert(spamConnections, folder.DescendantAdded:Connect(function(desc)
            onBrickAdded(desc, ownerName)
        end))
    end

    for _, child in ipairs(bricksFolder:GetChildren()) do
