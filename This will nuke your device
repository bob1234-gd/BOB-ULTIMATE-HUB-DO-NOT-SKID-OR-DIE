            workspace.Gravity = 196.2
        end
        flyLastJump = time()
    end)

    RunService.RenderStepped:Connect(function()
        if LocalPlayer:GetAttribute("Flying") ~= true or not flyIsActive then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        workspace.Gravity = 1
        hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity / 1.1
        hrp.AssemblyAngularVelocity = hrp.AssemblyAngularVelocity / 1.1
        local cam = workspace.CurrentCamera
        local sum = Vector3.zero
        local mv = Vector3.zero
        pcall(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local pm = ps and ps:FindFirstChild("PlayerModule")
            local cm = pm and pm:FindFirstChild("ControlModule")
            if cm then
                mv = require(cm):GetMoveVector()
            end
        end)
        if mv.Magnitude < 0.05 then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then sum = sum + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then sum = sum - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then sum = sum - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then sum = sum + cam.CFrame.RightVector end
        else
            if mv.X > 0.5 then sum = sum + cam.CFrame.RightVector end
            if mv.X < -0.5 then sum = sum - cam.CFrame.RightVector end
            if mv.Z > 0.5 then sum = sum - cam.CFrame.LookVector end
            if mv.Z < -0.5 then sum = sum + cam.CFrame.LookVector end
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then sum = sum + cam.CFrame.UpVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then sum = sum - cam.CFrame.UpVector end
        hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity + sum * ((hum.WalkSpeed or 16) / 10 * 2.5)
        char:PivotTo(CFrame.new(char:GetPivot().Position, char:GetPivot().Position + cam.CFrame.LookVector))
    end)

    LocalPlayer:GetAttributeChangedSignal("Flying"):Connect(function()
        if LocalPlayer:GetAttribute("Flying") ~= false then return end
        flyIsActive = false
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum then hum.PlatformStand = false end
        if hrp and hrp:FindFirstChild("Running") then hrp.Running.Volume = 0.65 end
        workspace.Gravity = 196.2
    end)
end

