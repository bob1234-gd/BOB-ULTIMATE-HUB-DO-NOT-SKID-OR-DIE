                if not alive() then return end
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if hotSlots[i].tool then
                    startDrag(hotSlots[i].tool, "hot", i)
                end
            end)
            btn.MouseButton1Click:Connect(function()
                if dragging or not alive() then return end
                if hotSlots[i].tool then equipTool(hotSlots[i].tool) end
            end)
        end

        local function refreshInvGrid()
            if not alive() then return end
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("ImageButton") then c:Destroy() end
            end
            local onHot = {}
            for i = 1, 9 do
                if hotSlots[i].tool then onHot[hotSlots[i].tool] = true end
            end
            local q = string.lower(searchBox.Text or "")
            for _, tool in ipairs(uniqueTools()) do
                if not onHot[tool] then
                    if q == "" or string.find(string.lower(tool.Name), q, 1, true) then
                        local btn = Instance.new("ImageButton")
                        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
                        btn.BackgroundTransparency = 0.2
                        btn.AutoButtonColor = false
                        btn.Parent = scroll
                        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
                        local st = Instance.new("UIStroke")
                        st.Color = theme
                        st.Thickness = 1
                        st.Parent = btn
                        trackTheme(st)
                        styleSlot(btn, tool, nil)
                        btn.InputBegan:Connect(function(input)
                            if not alive() then return end
                            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                            startDrag(tool, "bag", nil)
                        end)
                        btn.MouseButton1Click:Connect(function()
                            if dragging or not alive() then return end
                            equipTool(tool)
                        end)
                    end
                end
            end
            -- pad to 50 slots total in bag grid
            local count = 0
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("ImageButton") then count = count + 1 end
            end
            for i = count + 1, 50 do
                local empty = Instance.new("ImageButton")
                empty.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
                empty.BackgroundTransparency = 0.35
                empty.AutoButtonColor = false
                empty.Parent = scroll
                Instance.new("UICorner", empty).CornerRadius = UDim.new(0, 6)
                local st = Instance.new("UIStroke")
                st.Color = theme
                st.Thickness = 1
                st.Transparency = 0.5
                st.Parent = empty
                trackTheme(st)
                empty.InputBegan:Connect(function(input)
                    if not alive() or not dragging then return end
                    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                    -- drop into bag
                    if dragFrom == "hot" and dragging.tool then
                        for j = 1, 9 do
                            if hotSlots[j].tool == dragging.tool then hotSlots[j].tool = nil end
                        end
                        stopDrag()
                        refreshAll()
                    end
                end)
            end
        end

        refreshAll = function()
            if not alive() then return end
            local tools = uniqueTools()
            local set = {}
            for _, t in ipairs(tools) do set[t] = true end
            for i = 1, 9 do
                if hotSlots[i].tool and not set[hotSlots[i].tool] then
                    hotSlots[i].tool = nil
                end
            end
            local used = {}
            for i = 1, 9 do
                if hotSlots[i].tool then used[hotSlots[i].tool] = true end
            end
            local ti = 1
            for i = 1, 9 do
                if not hotSlots[i].tool then
                    while tools[ti] and used[tools[ti]] do ti = ti + 1 end
                    if tools[ti] then
                        hotSlots[i].tool = tools[ti]
                        used[tools[ti]] = true
                        ti = ti + 1
                    end
                end
            end
            for i = 1, 9 do
                styleSlot(hotSlots[i].btn, hotSlots[i].tool, i)
            end
            refreshInvGrid()
        end

        local function toggleInv()
            if not alive() then return end
            invOpen = not invOpen
            invFrame.Visible = invOpen
            refreshAll()
        end
        openBtn.MouseButton1Click:Connect(toggleInv)

        UserInputService.InputBegan:Connect(function(input, gp)
            if gp or not alive() then return end
            if input.KeyCode == Enum.KeyCode.Backquote then
                toggleInv()
            elseif input.KeyCode.Value >= Enum.KeyCode.One.Value and input.KeyCode.Value <= Enum.KeyCode.Nine.Value then
                local idx = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
                if hotSlots[idx] and hotSlots[idx].tool then
                    equipTool(hotSlots[idx].tool)
                end
            end
        end)

