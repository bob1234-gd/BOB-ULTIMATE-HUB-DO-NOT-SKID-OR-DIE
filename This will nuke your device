local function addMessageToFeed(senderName, messageText, color)
    if isDuplicate(senderName, messageText) then return end

    local isMuted = false
    pcall(function()
        local blockedUsers = StarterGui:GetCore("GetBlockedUserIds")
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == senderName and table.find(blockedUsers, p.UserId) then
                isMuted = true
                break
            end
        end
    end)

    if isMuted then
        senderName = "[MUTED/HIDDEN] " .. senderName
        color = Color3.fromRGB(150, 150, 150)
    end

    local decalId = messageText:match("roblox%.com/BobUltimatechat/DECAL/(%d+)")
    local audioId = messageText:match("roblox%.com/BobUltimatechat/AUDIO/(%d+)")
    
