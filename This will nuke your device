local function formatRichText(inputText)
    local result = ""
    for i = 1, #inputText do
        local char = inputText:sub(i, i)
        if i % 2 == 0 then
            result = result .. "<b>" .. string.lower(char) .. "</b>"
        else
            result = result .. string.lower(char)
        end
    end
    return result
end

