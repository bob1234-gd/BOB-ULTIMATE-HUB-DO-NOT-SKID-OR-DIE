local remoteMaps = {} -- { {Name=, Author=, Url=}, ... }
local remoteMapButtons = {}

local function clearRemoteMapButtons()
    for _, btn in ipairs(remoteMapButtons) do
        if btn and btn.Parent then
            btn.Parent:Destroy()
        end
    end
