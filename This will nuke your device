-- FE collide: paint material "collide" toggles CanCollide on server
local function feToggleAnchor(remote, part)
    -- clear spray on Top first (some servers need this for anchor to apply)
    pcall(function()
        remote:FireServer(part, Enum.NormalId.Top, part.Position, "both 🤝", Color3.new(0, 0, 0), "spray", "")
    end)
    task.wait(0.04)
    pcall(function()
        remote:FireServer(part, Enum.NormalId.Top, part.Position, "material", Color3.new(0, 0, 0), "anchor", "")
    end)
    task.wait(0.03)
    pcall(function()
        remote:FireServer(part, Enum.NormalId.Top, part.Position, "both 🤝", Color3.new(0, 0, 0), "anchor", "")
    end)
end

local function feToggleCollide(remote, part)
    pcall(function()
        remote:FireServer(part, Enum.NormalId.Top, part.Position, "material", Color3.new(0, 0, 0), "collide", "")
    end)
    task.wait(0.03)
    pcall(function()
        remote:FireServer(part, Enum.NormalId.Top, part.Position, "both 🤝", Color3.new(0, 0, 0), "collide", "")
    end)
end

