                                local k = t:sub(2,2)
                                score = ({P=10,N=30,B=30,R=50,Q=90,K=1000})[k] or 5
                            end
                            -- prefer moves that attack white king
                            local save = board[m.y][m.x]
                            local from = board[sy][sx]
                            board[m.y][m.x] = from
                            board[sy][sx] = ""
                            local kx, ky = findKing("w")
                            if kx and squareAttacked(kx, ky, "b") then
                                score = score + 40
