    local function getGold()
        local function asNum(v)
            if v == nil then return nil end
            if typeof(v) == "number" then return v end
            if typeof(v) == "string" then
                return tonumber((tostring(v):gsub("[^%d%-%.]", "")))
            end
            -- TextLabel / TextBox
            if typeof(v) == "Instance" then
                if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
                    return tonumber((tostring(v.Text):gsub("[^%d%-%.]", "")))
                end
                if v:IsA("IntValue") or v:IsA("NumberValue") or v:IsA("StringValue") then
                    return asNum(v.Value)
                end
            end
            return tonumber(v)
        end

        -- BABFT official path: PlayerGui.GoldGui.Frame.Amount
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            local goldGui = pg:FindFirstChild("GoldGui")
            if goldGui then
                local frame = goldGui:FindFirstChild("Frame")
                if frame then
                    local amount = frame:FindFirstChild("Amount")
                    if amount then
                        local n = asNum(amount)
                        if n then return n end
                    end
                end
                -- fallback: any Amount under GoldGui
                local amount2 = goldGui:FindFirstChild("Amount", true)
                if amount2 then
                    local n = asNum(amount2)
                    if n then return n end
                end
            end
        end

        -- leaderstats fallback
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            for _, name in ipairs({"Gold", "gold", "Cash", "Money", "Coins"}) do
                local v = ls:FindFirstChild(name)
                if v then
                    local n = asNum(v.Value)
                    if n then return n end
                end
            end
        end

        return nil
    end

