-- Bob Clan group coloring (green = member, black = Banned role)
-- VIP overrides: yellow / blue + crown
local CLAN_GROUP_ID = 238432240
local clanStatusCache = {} -- userId -> "member" | "banned" | "none"
function getClanStatus(userId)
    if clanStatusCache[userId] ~= nil then return clanStatusCache[userId] end
    local status = "none"
    pcall(function()
        local groups = Players:GetGroupsAsync(userId)
        for _, g in ipairs(groups) do
            if g.Id == CLAN_GROUP_ID then
                local role = tostring(g.Role or "")
                if role:lower() == "banned" then
                    status = "banned"
                else
                    status = "member"
                end
                break
            end
        end
    end)
    clanStatusCache[userId] = status
    return status
end
function clanNameColor(userId, fallback)
    local vip = getVipByUserId(userId)
    if vip then return vip.color end
    local s = getClanStatus(userId)
    if s == "banned" then
        return Color3.fromRGB(0, 0, 0)
    elseif s == "member" then
        return Color3.fromRGB(40, 220, 70)
    end
    return fallback or Color3.fromRGB(240, 240, 245)
end

function formatPlayerNameTag(plr)
    if not plr then return "?" end
    local vip = getVipByPlayer(plr)
    local base = plr.DisplayName or plr.Name
    if vip and vip.crown then
        return "👑 " .. base
    end
    return base
end

