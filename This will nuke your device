local TCO_IDS = {[11137575513]=true,[12943245078]=true,[12943247001]=true,[108097274488844]=true}

local function spyHasArkenstone(plr)
    local bp = plr:FindFirstChildOfClass("Backpack")
    local char = plr.Character
    if bp and bp:FindFirstChild("The Arkenstone") then return true end
    if char and char:FindFirstChild("The Arkenstone") then return true end
    return false
end

local function spyIsAdmin(plr)
    local chosen = game:GetService("Teams"):FindFirstChild("Chosen")
    return chosen and plr.Team == chosen
end

local function spyIsMuted(plr)
    local ok, muted = pcall(function() return plr:HasTag("Muted") end)
    return ok and muted
end

local function spyMsgHasCommand(msg)
    local stripped = (msg:sub(1,1) == ";") and msg:sub(2) or msg
    local first = (stripped:match("^(%S+)") or ""):lower()
    return spyCommandSet[first] == true
end

local function spyAnnounce(text)
    local now = tick()
    if now - lastSpyAlert < 0.35 then return end
    lastSpyAlert = now
    sendDetectorChat(text)
    ShowNotification("Chat Spy", text)
end

-- Single OnIncomingMessage (ChatSpy + alerts)
-- NEVER modifies LocalPlayer messages (star on your own chat breaks cmds)
pcall(function()
    TextChatService.OnIncomingMessage = function(mdata)
        if not TCO_IDS[game.PlaceId] then return end
        local src = mdata.TextSource
        if not src then return end
        local plr = Players:GetPlayerByUserId(src.UserId)
        if not plr then return end

        -- Always leave YOUR messages alone (enlighten star / tags would break cmds)
        if plr == LocalPlayer then return end

        local muted = spyIsMuted(plr)
        local text = mdata.Text or ""
        local hidden = text:sub(1, 1) == ";"

        -- Without Chat Spy: hide muted + silent cmds (game default behavior)
        if not chatSpyOn then
            if muted or hidden then
                mdata.Text = ""
            end
        else
            local tags = ""
            -- stars only if "Show who has enlighten" is ON (never on yourself — already returned)
            if showEnlightenStars and spyHasArkenstone(plr) then tags = tags .. "🌟" end
            if hidden then tags = tags .. "🚫" end
            if muted then tags = tags .. "🤐" end
            if plr:GetAttribute("IQ") then
                local iq = plr:GetAttribute("IQ")
                if type(iq) == "number" then
                    if iq >= 200 then tags = tags .. "🧠"
                    elseif iq <= 50 then tags = tags .. "🤪" end
                end
            end
            if tags ~= "" and text ~= "" then
                mdata.Text = tags .. " " .. text
            end
        end

        -- also allow stars when chat spy is off but showEnlightenStars is on
        if not chatSpyOn and showEnlightenStars and spyHasArkenstone(plr) and text ~= "" then
            mdata.Text = "🌟 " .. text
        end

        local rawMsg = text
        local displayName = plr.DisplayName or plr.Name
        if rawMsg == "" then return end

        local silent = rawMsg:sub(1, 1) == ";"
        local mutedPrefix = muted and "MUTED " or ""
        local caught = false

        -- Alert Enlighteners / admins using hidden cmds (ArkSpy)
        if alertEnlightenersOn or alertHiddenCmdsOn then
            local admin = spyIsAdmin(plr)
            local ark = spyHasArkenstone(plr)
            if (admin or ark) and spyMsgHasCommand(rawMsg) then
                if (muted and alertEnlightenersOn) or (silent and (alertHiddenCmdsOn or alertEnlightenersOn)) then
                    caught = true
                    task.spawn(function()
                        spyAnnounce(mutedPrefix .. displayName .. ": " .. rawMsg)
                    end)
                end
            elseif silent and alertHiddenCmdsOn and spyMsgHasCommand(rawMsg) then
                caught = true
                task.spawn(function()
                    spyAnnounce(mutedPrefix .. displayName .. ": " .. rawMsg)
                end)
            end
        end

        -- Alert Donations (silent / muted)
        if alertDonationsOn then
            local low = rawMsg:lower()
            local isDonate = low:match("^;?%s*donate%s") or low:match("^;?%s*donate$")
            if isDonate and (muted or silent) then
                caught = true
                task.spawn(function()
                    spyAnnounce(mutedPrefix .. displayName .. ": " .. rawMsg)
                end)
            end
        end

        -- Alert Muted Msgs (non-silent muted chat)
        if alertMutedOn and muted and not silent and not caught then
            task.spawn(function()
                spyAnnounce("MUTED " .. displayName .. ": " .. rawMsg)
            end)
        end
    end
end)

end -- Detectors scope

