-- Watches Color / Material changes on bricks belonging to other players
local paintConnections = {}

local function disconnectPaintWatchers()
    for _, c in ipairs(paintConnections) do if c then c:Disconnect() end end
    table.clear(paintConnections)
end

local function setupPaintWatchers()
    disconnectPaintWatchers()
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    if not bricksFolder then
        ShowNotification("Paint Detector", "Bricks folder not found.")
        return
    end

    local function watchBrick(brick, ownerName)
        if not brick:IsA("BasePart") or brick.Name ~= "Brick" then return end

        local function onPainted()
            if not paintDetectorEnabled then return end
            local now = tick()
            if now - lastPaintAlertTime < detectorCooldown then return end

            -- Owner painting their own → skip
            local ownerPlayer = Players:FindFirstChild(ownerName)
            if ownerPlayer then
                local oChar = ownerPlayer.Character
                local ownerPainting = (oChar and oChar:FindFirstChild("Paint"))
                    or (recentToolUsers[ownerPlayer.UserId] and recentToolUsers[ownerPlayer.UserId].Paint
                        and now - recentToolUsers[ownerPlayer.UserId].Paint < 8)
                if ownerPainting then return end
            end
            if ownerName == LocalPlayer.Name then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("Paint") then return end
            end

            local suspects = findSuspects("Paint", brick.Position, ownerName)
            local real = {}
            for _, s in ipairs(suspects) do
                if s.player.Name ~= ownerName then table.insert(real, s) end
            end

            if #real == 0 then
                lastPaintAlertTime = now
                local msg = string.format("[Paint Alert] [UNKNOWN] %s's blocks being painted (possible exploit)!", ownerName)
                sendDetectorChat(msg)
                ShowNotification("Paint Detector", msg)
                return
            end

            local top = real[1]
            if top.player == LocalPlayer then
                ShowNotification("Paint Detector", "You painted a block from " .. ownerName)
                return
            end
            if isWhitelisted(top.player) then return end

            lastPaintAlertTime = now
            local tag = top.remote and " [REMOTE/EXPLOIT?]" or ""
            local msg = string.format("[Paint Alert]%s %s is painting %s's blocks!", tag, top.player.Name, ownerName)
            sendDetectorChat(msg)
            ShowNotification("Paint Detector", msg)
        end

        table.insert(paintConnections, brick:GetPropertyChangedSignal("Color"):Connect(onPainted))
        table.insert(paintConnections, brick:GetPropertyChangedSignal("Material"):Connect(onPainted))
    end

    local function watchFolder(folder)
        if not folder then return end
        local ownerName = folder.Name
        for _, desc in ipairs(folder:GetDescendants()) do
            if desc:IsA("BasePart") and desc.Name == "Brick" then
                watchBrick(desc, ownerName)
            end
        end
        table.insert(paintConnections, folder.DescendantAdded:Connect(function(desc)
            if desc:IsA("BasePart") and desc.Name == "Brick" then
                watchBrick(desc, ownerName)
            end
        end))
    end

    for _, child in ipairs(bricksFolder:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then watchFolder(child) end
    end
    table.insert(paintConnections, bricksFolder.ChildAdded:Connect(function(child)
        if child:IsA("Folder") or child:IsA("Model") then watchFolder(child) end
    end))
end

