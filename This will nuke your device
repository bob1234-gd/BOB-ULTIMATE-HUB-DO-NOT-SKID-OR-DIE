-- Flat list used by Music Bot (built from categories)
local musicLibrary = {}
for _, category in ipairs(musicCategories) do
    for _, song in ipairs(category.songs) do
        table.insert(musicLibrary, song)
    end
end


local autoBoomboxEnabled = false
local musicBotEnabled = false
local musicBotThread = nil
local lastPlayedId = nil
local isSwitchingSong = false -- hard lock so we never spam

local function getBoomboxTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("SuperFlyGoldBoombox"))
        or (backpack and backpack:FindFirstChild("SuperFlyGoldBoombox"))
end

local function getBoomboxSound()
    local tool = getBoomboxTool()
    if not tool then return nil end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return nil end
    return handle:FindFirstChildOfClass("Sound")
end

local function playOnBoombox(songId, songName)
    local tool = getBoomboxTool()
    if not tool then
        ShowNotification("Bob Engine", "SuperFlyGoldBoombox not found! Get one from admin first.")
        return false
    end

    local remote = tool:FindFirstChild("Remote")
    if not remote then
        ShowNotification("Bob Engine", "Boombox Remote missing.")
        return false
    end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if tool.Parent == backpack and humanoid then
        humanoid:EquipTool(tool)
        task.wait(0.2)
    end

    remote:FireServer("PlaySong", tonumber(songId))
    lastPlayedId = tostring(songId)

    if songName then
        ShowNotification("Bob Engine", "Playing: " .. songName)
    else
        ShowNotification("Bob Engine", "Playing on Boombox: " .. tostring(songId))
    end
    return true
end

local function forceChat(msg)
    local channel = TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral")
    if channel then
        pcall(function()
            channel:SendAsync(msg)
        end)
    else
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("DefaultChatSystemChatEvents"):WaitForChild("SayMessageRequest"):FireServer(msg, "All")
        end)
    end
end

local function handleMusicId(songId, songName)
    if autoBoomboxEnabled then
        playOnBoombox(songId, songName)
        if songName then
            forceChat('[Now Playing:] "' .. songName .. '"')
        end
    else
        setclipboard(tostring(songId))
        ShowNotification("Bob Engine", "COPIED TO CLIPBOARD")
    end
end

local function pickRandomSong()
    if #musicLibrary == 0 then return nil end
    local song
    for _ = 1, 10 do
        song = musicLibrary[math.random(1, #musicLibrary)]
        if tostring(song.id) ~= lastPlayedId then
            break
        end
    end
    return song
end

local function stopMusicBot()
    musicBotEnabled = false
    isSwitchingSong = false
    if musicBotThread then
        task.cancel(musicBotThread)
        musicBotThread = nil
    end
end

local function startMusicBot()
    stopMusicBot()
    musicBotEnabled = true
    isSwitchingSong = false

    musicBotThread = task.spawn(function()
        while musicBotEnabled do
            -- Wait until we are allowed to check again
            if isSwitchingSong then
                task.wait(0.5)
                continue
            end

            local sound = getBoomboxSound()

            -- No sound yet → wait a bit
            if not sound then
                task.wait(1)
                continue
            end

            -- Wait until the sound has actually finished (or isn't playing)
            -- We only switch when TimeLength is known AND TimePosition is near the end
            -- OR when IsPlaying is false after we already started a song
            local timeLen = sound.TimeLength or 0
            local timePos = sound.TimePosition or 0
            local isPlaying = sound.IsPlaying

            local finished = false
            if timeLen > 2 and timePos >= (timeLen - 0.8) then
                finished = true
            elseif not isPlaying and lastPlayedId ~= nil then
                -- sound stopped and we previously played something
                finished = true
            end

            if finished then
                isSwitchingSong = true -- LOCK

                local song = pickRandomSong()
                if song and musicBotEnabled then
                    playOnBoombox(song.id, song.name)
                    forceChat('[Now Playing:] "' .. song.name .. '"')

                    -- Give the new sound time to start loading/playing
                    task.wait(3) -- important debounce
                end

                isSwitchingSong = false -- UNLOCK
            else
                -- Song still playing → check again in 1 second
                task.wait(1)
            end
        end
    end)
end

