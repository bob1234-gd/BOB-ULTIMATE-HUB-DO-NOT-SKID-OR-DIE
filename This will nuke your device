            if not dragging then return end
            local tool = dragging.tool
            local idx = slotUnderMouse()
            if idx and tool and tool.Parent then
                for j = 1, 9 do
                    if hotSlots[j].tool == tool then hotSlots[j].tool = nil end
                end
                local other = hotSlots[idx].tool
                hotSlots[idx].tool = tool
                if other and dragFrom == "hot" and dragFromIndex and dragFromIndex ~= idx then
