local isDragging = false
local isResizing = false
local inputStart
local startPos
local startSize
local targetDragPos = MainFrame.Position

RunService.RenderStepped:Connect(function(dt)
    if glidePhysicsEnabled and not isResizing then
        MainFrame.Position = MainFrame.Position:Lerp(targetDragPos, 10 * dt)
    end
end)

ResizeGrip.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isResizing = true
        inputStart = input.Position
        startSize = MainFrame.AbsoluteSize
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                isResizing = false
            end
        end)
    end
end)

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if not isResizing and not UserInputService:GetFocusedTextBox() then
            isDragging = true
            inputStart = input.Position
            startPos = glidePhysicsEnabled and targetDragPos or MainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDragging = false
                end
            end)
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if isResizing then
            local delta = input.Position - inputStart
            local scale = mainScale and mainScale.Scale or 1
            local newWidth = math.clamp(startSize.X + (delta.X / scale), 250, 800)
            local newHeight = math.clamp(startSize.Y + (delta.Y / scale), 150, 600)
            MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
            
        elseif isDragging then
            local delta = input.Position - inputStart
            local scale = mainScale and mainScale.Scale or 1
            local calculatedPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + (delta.X / scale), 
                startPos.Y.Scale, startPos.Y.Offset + (delta.Y / scale)
            )
            
            targetDragPos = calculatedPos
            if not glidePhysicsEnabled then
                MainFrame.Position = calculatedPos
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
        isResizing = false
    end
end)

