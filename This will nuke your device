local pendingMessage = ""

local function executeSend(mediaType)
    PromptFrame.Visible = false
    local processedMessage = pendingMessage
    if mediaType == "DECAL" or mediaType == "AUDIO" then
        for assetId in pendingMessage:gmatch("%d%d%d%d%d%d+") do
            processedMessage = processedMessage:gsub(assetId, "roblox.com/BobUltimatechat/" .. mediaType .. "/" .. assetId .. "/")
        end
    end

    if madMewMewEnabled then
        processedMessage = toMadMewMew(processedMessage)
        sendRawMessage(processedMessage) -- No fullwidth when Mad Mew Mew is ON
    else
        sendRawMessage(convertToFont(processedMessage))
    end
end

BtnDecal.MouseButton1Click:Connect(function() executeSend("DECAL") end)
BtnAudio.MouseButton1Click:Connect(function() executeSend("AUDIO") end)
BtnText.MouseButton1Click:Connect(function() executeSend("TEXT") end)

local function sendMessage(message)
    if message == "" then return end
    if os.time() < paintCooldownEnd then return end
    if #message > MAX_CHARACTER_LIMIT then
        sendRawMessage("User has typed to long [bob ultimate chat]")
        return
    end

    local clean = message:lower():gsub("%s+", " "):match("^%s*(.-)%s*$")
    if clean == "/clear" then
        for _, child in ipairs(ScrollFeed:GetChildren()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then child:Destroy() end
        end
        ScrollFeed.CanvasSize = UDim2.new(0, 0, 0, 0)
        addMessageToFeed("SYSTEM", "Chat history cleared locally.", Color3.fromRGB(255, 170, 0))
        return
    end

    local foundId = message:match("%d%d%d%d%d%d+")
    if foundId then
        pendingMessage = message
        PromptFrame.Visible = true
    else
        if madMewMewEnabled then
            sendRawMessage(toMadMewMew(message)) -- No fullwidth
        else
            sendRawMessage(convertToFont(message))
        end
    end
end

