-- ---------- Delete Detector ----------
local deleteConnections = {}

local function disconnectDeleteWatchers()
    for _, c in ipairs(deleteConnections) do if c then c:Disconnect() end end
    table.clear(deleteConnections)
end

local function setupDeleteWatchers()
    disconnectDeleteWatchers()
    local bricksFolder = Workspace:FindFirstChild("Bricks")
    if not bricksFolder then
        ShowNotification("Delete Detector", "Bricks folder not found.")
        return
    end

    local function watchFolder(folder)
        if not folder then return end
        local conn = folder.DescendantRemoving:Connect(function(desc)
            if not deleteDetectorEnabled then return end
            if not (desc:IsA("BasePart") and desc.Name == "Brick") then return end

            local ownerName = folder.Name
            local brickPos = desc.Position
            local now = tick()
            if now - lastDeleteAlertTime < detectorCooldown then return end

            -- Owner self-delete → skip
            local ownerPlayer = Players:FindFirstChild(ownerName)
            if ownerPlayer then
                local oChar = ownerPlayer.Character
                local ownerDeleting = (oChar and oChar:FindFirstChild("Delete"))
                    or (recentToolUsers[ownerPlayer.UserId] and recentToolUsers[ownerPlayer.UserId].Delete
                        and now - recentToolUsers[ownerPlayer.UserId].Delete < 8)
                if ownerDeleting then return end
            end
            if ownerName == LocalPlayer.Name then
                local myChar = LocalPlayer.Character
                if myChar and myChar:FindFirstChild("Delete") then return end
            end

            local suspects = findSuspects("Delete", brickPos, ownerName)
            local real = {}
            for _, s in ipairs(suspects) do
                if s.player.Name ~= ownerName then table.insert(real, s) end
            end

            if #real == 0 then
                lastDeleteAlertTime = now
                local msg = string.format("[Delete Alert] [UNKNOWN] Blocks vanishing from %s (possible exploit)!", ownerName)
                sendDetectorChat(msg)
                ShowNotification("Delete Detector", msg)
                return
            end

            local top = real[1]
            if top.player == LocalPlayer then
                ShowNotification("Delete Detector", "You deleted a block from " .. ownerName)
                return
            end
            if isWhitelisted(top.player) then return end

            lastDeleteAlertTime = now
            local tag = top.remote and " [REMOTE/EXPLOIT?]" or ""
            local msg = string.format("[Delete Alert]%s %s is deleting %s's blocks!", tag, top.player.Name, ownerName)
            sendDetectorChat(msg)
            ShowNotification("Delete Detector", msg)
        end)
        table.insert(deleteConnections, conn)
    end

    for _, child in ipairs(bricksFolder:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then watchFolder(child) end
    end
    table.insert(deleteConnections, bricksFolder.ChildAdded:Connect(function(child)
        if child:IsA("Folder") or child:IsA("Model") then watchFolder(child) end
    end))
end

