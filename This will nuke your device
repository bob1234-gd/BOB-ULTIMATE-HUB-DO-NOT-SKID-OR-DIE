local function createParentTab(name)
    local parent = createTab(name)
    -- Disable list layout so sub-bar + sub-pages can use absolute layout
    for _, child in ipairs(parent.Container:GetChildren()) do
        if child:IsA("UIListLayout") or child:IsA("UIPadding") then
            child:Destroy()
        end
    end
    -- Parent ScrollingFrame must have a real canvas size or scaled children get height 0
    parent.Container.ScrollingEnabled = false
    parent.Container.ScrollBarThickness = 0
    parent.Container.ClipsDescendants = true
    local function syncParentCanvas()
        local abs = parent.Container.AbsoluteSize
        if abs.X > 0 and abs.Y > 0 then
            parent.Container.CanvasSize = UDim2.new(0, abs.X, 0, abs.Y)
