local RANK_FILE = "BobHub_Ranks_v1.json"
local BAN_FILE = "BobHub_DeepBan_v1.dat" -- deep check on device
local rankDB = {} -- [lowercaseUsername] = number

local function loadRanks()
    rankDB = {}
    pcall(function()
        if readfile and isfile and isfile(RANK_FILE) then
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(RANK_FILE)) end)
            if ok and type(data) == "table" then rankDB = data end
        end
    end)
    -- founders always rank 0
    rankDB["spacekittiezbob"] = 0
    rankDB["seiryufujin"] = 0
end

local function saveRanks()
    pcall(function()
        if writefile then writefile(RANK_FILE, HttpService:JSONEncode(rankDB)) end
    end)
end

loadRanks()

local function getPlayerRank(name)
    local n = normalizeName(name)
    if BOB_VIPS[n] then return 0 end
    local r = rankDB[n]
    if r == nil then return nil end -- unverified
    return tonumber(r)
end

local function rankLabel(r)
    if r == nil then return "Unverified" end
    if r == 0 then return "Rank 0 (Owner)" end
    return "Rank " .. tostring(r)
end

local function setPlayerRank(name, rankNum)
    local n = normalizeName(name)
    if n == "" then return false end
    rankNum = tonumber(rankNum)
    if not rankNum then return false end
    rankNum = math.floor(rankNum)
    if rankNum < 0 then rankNum = 0 end
    rankDB[n] = rankNum
    saveRanks()
    return true
end

local function isLocalOwner()
    -- Admin Panel: SpaceKittiezBob only (not seiryu)
    return normalizeName(LocalPlayer.Name) == "spacekittiezbob"
        or normalizeName(LocalPlayer.DisplayName) == "spacekittiezbob"
end

local function isBannedLocal()
    local banned = false
    pcall(function()
        if isfile and isfile(BAN_FILE) then
            local raw = readfile(BAN_FILE)
            if raw and raw:find("BANNED") and not raw:find("UNBANNED") then
                banned = true
            end
        end
    end)
    return banned
end

local function writeBanForTarget(username, userId)
