            if state.carryMeat > 0 then
                state.carryMeat = state.carryMeat - 1
            else
                state.rawFish = state.rawFish - 1
            end
            state.cooked = state.cooked + 1
            state.fire = math.max(0, state.fire - 1) -- 1% waste
            status.Text = "Cooked food (−1% fire)"
            refreshHUD()
        end

