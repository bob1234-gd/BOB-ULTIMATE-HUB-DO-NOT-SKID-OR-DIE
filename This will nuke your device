local function dropAllTools()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end
    droppedToolRefs = {}
    local function dropFrom(container)
        if not container then return end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                pcall(function()
                    tool.Parent = workspace
                    table.insert(droppedToolRefs, tool)
                end)
            end
        end
    end
    dropFrom(char)
    dropFrom(backpack)
end

local function grabDroppedTools()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not hrp or not backpack then return end
    -- TP to each dropped tool and pick it up
    for _, tool in ipairs(droppedToolRefs) do
        if tool and tool.Parent == workspace then
            local handle = tool:FindFirstChild("Handle")
            local pos = handle and handle.Position
            if pos then
                pcall(function()
                    char:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
                end)
                task.wait(0.15)
                pcall(function() tool.Parent = backpack end)
            end
        end
    end
    -- also grab any nearby tools in workspace
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Tool") then
            local handle = obj:FindFirstChild("Handle")
            local pos = handle and handle.Position
            if pos and (pos - hrp.Position).Magnitude <= 25 then
                pcall(function() obj.Parent = backpack end)
            end
        end
    end
    droppedToolRefs = {}
end

