        local function feedFire()
            if not state.alive then return end
            if state.carrying > 0 then
                state.carrying = state.carrying - 1
                state.fire = state.fire + 12 -- harder leveling
                state.fireUnlocked = true
            elseif state.coal > 0 and state.fireUnlocked then
                state.coal = state.coal - 1
                state.fire = state.fire + 18
            else
                status.Text = state.fireUnlocked and "Carry logs to the fire" or "Put wood in campfire to unlock it"
                return
            end
            if state.fire >= 100 and state.fireLevel < 5 then
                -- harder: need overfill; waste more heat
                state.fireLevel = state.fireLevel + 1
                state.fireRange = math.min(0.35, 0.12 + state.fireLevel * 0.04)
                state.fire = state.fire * 0.35
                applyPlaySize(state.fireLevel >= 5 and 5 or state.fireLevel)
                status.Text = "Fire LEVEL " .. state.fireLevel .. "/5"
            elseif state.fire >= 100 and state.fireLevel >= 5 then
                state.fire = 85
                status.Text = "Max fire level 5 — big area unlocked"
            else
                status.Text = "Fed campfire"
            end
            state.fire = math.clamp(state.fire, 0, 100)
            state.cold = math.max(0, state.cold - 10)
            -- torch refills near fire
            if state.hasTorchItem then
                state.torch = math.min(100, state.torch + 25)
            end
